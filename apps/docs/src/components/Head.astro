---
// Starlight `Head` override — renders the default head, then adds Astro's
// ClientRouter so doc-to-doc navigation morphs smoothly (Starlight ships no
// view transitions by default). Keeps every other head tag Starlight emits.
import Default from "@astrojs/starlight/components/Head.astro";
import { ClientRouter } from "astro:transitions";
---

<Default><slot /></Default>
<ClientRouter />

<script is:inline>
  // Default the docs to dark (the cosmos space theme's front door), matching
  // the marketing site. Runs after Starlight's own theme script; only applies
  // when the visitor has no saved preference, so the toggle still wins.
  try {
    if (!localStorage.getItem("starlight-theme")) {
      document.documentElement.dataset.theme = "dark";
    }
  } catch (_) {}
</script>

<script is:inline>
  // Cosmic background — starfield canvas + nebula blobs, matching the
  // "Backlex Docs" design. Injected into <body> (behind .page via CSS) and
  // re-attached after <ClientRouter /> view-transition swaps. CSS hides it in
  // light theme.
  (function () {
    function startStars(c) {
      var ctx = c.getContext("2d");
      var w = 0, h = 0, dpr = 1, stars = [], raf = 0;
      function make() {
        stars = [];
        var n = Math.round((w * h) / 8000);
        for (var i = 0; i < n; i++) {
          var d = Math.random();
          stars.push({ x: Math.random() * w, y: Math.random() * h, r: d * 1.3 + 0.2, depth: d * 0.6 + 0.12, drift: 0.015 + d * 0.04, tw: Math.random() * 6.28, sp: 0.003 + Math.random() * 0.006 });
        }
      }
      function resize() {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = window.innerWidth; h = window.innerHeight;
        c.width = w * dpr; c.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        make();
      }
      function tick() {
        if (!document.body.contains(c)) { window.removeEventListener("resize", resize); return; }
        ctx.clearRect(0, 0, w, h);
        var sy = window.scrollY || 0;
        for (var i = 0; i < stars.length; i++) {
          var s = stars[i];
          s.tw += s.sp; s.y += s.drift; if (s.y > h) s.y -= h;
          var a = 0.32 + Math.sin(s.tw) * 0.42;
          var yy = s.y - sy * s.depth * 0.15; yy = ((yy % h) + h) % h;
          ctx.globalAlpha = Math.max(0, a) * (0.4 + s.depth);
          ctx.fillStyle = s.depth > 0.45 ? "#cdbcff" : "#ffffff";
          ctx.beginPath(); ctx.arc(s.x, yy, s.r, 0, 6.283); ctx.fill();
        }
        ctx.globalAlpha = 1;
        raf = requestAnimationFrame(tick);
      }
      resize();
      window.addEventListener("resize", resize);
      cancelAnimationFrame(raf);
      tick();
    }
    function setup() {
      // The Head script runs while <body> is still parsing, so bail until it
      // exists; the listeners below re-invoke once the DOM is ready.
      if (!document.body || document.getElementById("cosmos-bg")) return;
      var wrap = document.createElement("div");
      wrap.id = "cosmos-bg";
      wrap.setAttribute("aria-hidden", "true");
      wrap.innerHTML =
        '<canvas id="stars"></canvas><div class="neb neb-a"></div><div class="neb neb-b"></div>';
      document.body.prepend(wrap);
      startStars(wrap.querySelector("#stars"));
    }
    document.addEventListener("astro:page-load", setup);
    document.addEventListener("DOMContentLoaded", setup);
    setup();
  })();
</script>

<script>
  // Preserve the Starlight sidebar's scroll position across <ClientRouter />
  // view-transition navigations. Starlight only persists the sidebar scroll on
  // `pageHide` / `visibilitychange` (full page unloads), which never fire under
  // client-side navigation — so the sidebar snapped back to the top on every
  // doc-to-doc click. We snapshot the scroller before the swap and restore it
  // after, independent of Starlight's sessionStorage/inline-restore internals.
  let sidebarScroll = 0;
  const sidebarScroller = () => document.getElementById("starlight__sidebar");

  document.addEventListener("astro:before-swap", () => {
    sidebarScroll = sidebarScroller()?.scrollTop ?? 0;
  });
  document.addEventListener("astro:after-swap", () => {
    const scroller = sidebarScroller();
    if (scroller && sidebarScroll) scroller.scrollTop = sidebarScroll;
  });
</script>
