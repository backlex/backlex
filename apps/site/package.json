{
  "name": "@backlex/site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Public marketing site for backlex — standalone Astro + Tailwind v4.",
  "scripts": {
    "dev": "bunx --bun astro dev",
    "start": "bunx --bun astro dev",
    "build": "astro check && astro build",
    "build:web": "astro build && bun run --cwd ../docs build && rm -rf dist/docs && cp -r ../docs/dist dist/docs",
    "deploy": "bun run build:web && wrangler deploy",
    "typecheck": "astro check",
    "preview": "bunx --bun astro preview",
    "astro": "bunx --bun astro"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.1"
  }
}
