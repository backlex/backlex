---
import Saturn from "./Saturn.astro";
// Shared footer — brand + Product / Cloud / Compare / Docs / Project columns.
---
<footer class="relative z-[1] pt-16 pb-12 border-t border-border bg-muted dark:bg-transparent">
  <div class="max-w-[1240px] mx-auto px-8 max-md:px-5">
    <div class="grid grid-cols-[1.4fr_repeat(5,1fr)] max-[1020px]:grid-cols-[1.4fr_repeat(2,1fr)] max-md:grid-cols-2 gap-10 max-md:gap-7">
      <div class="max-md:col-span-2">
        <a href="/" class="inline-flex items-center gap-2.5 no-underline">
          <Saturn size={28} />
          <span class="font-display font-semibold text-[16px] -tracking-[0.01em] text-foreground">backlex</span>
        </a>
        <p class="text-muted-foreground mt-4 text-[13.5px] max-w-[36ch] leading-snug">The AI-native backend you code and deploy globally. Dynamic schema, permissions DSL, realtime, vector search, and a built-in MCP server — one codebase on your own server (Bun, Node, Deno), Docker, Workers, Vercel, Netlify, AWS Lambda, Google Cloud &amp; Azure Functions, or Deno Deploy.</p>
      </div>
      <div>
        <div class="text-[11px] uppercase tracking-wider font-semibold text-muted-foreground mb-3.5">Product</div>
        <a href="/#ai" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">AI · MCP</a>
        <a href="/#features" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Features</a>
        <a href="/#global" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Global edge</a>
        <a href="/#stack" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Stack</a>
        <a href="https://cloud.backlex.com" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Open Cloud</a>
      </div>
      <div>
        <div class="text-[11px] uppercase tracking-wider font-semibold text-muted-foreground mb-3.5">Cloud</div>
        <a href="/#cloud" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Why Cloud</a>
        <a href="/pricing" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Pricing</a>
        <a href="https://cloud.backlex.com" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Cloud admin</a>
        <a href="https://status.backlex.com/" target="_blank" rel="noopener" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Status</a>
      </div>
      <div>
        <div class="text-[11px] uppercase tracking-wider font-semibold text-muted-foreground mb-3.5">Compare</div>
        <a href="/vs-supabase" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">backlex vs Supabase</a>
        <a href="/vs-firebase" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">backlex vs Firebase</a>
        <a href="/vs-directus" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">backlex vs Directus</a>
        <a href="/vs-strapi" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">backlex vs Strapi</a>
        <a href="/vs-appwrite" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">backlex vs Appwrite</a>
        <a href="/vs-aws-amplify" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">backlex vs AWS Amplify</a>
      </div>
      <div>
        <div class="text-[11px] uppercase tracking-wider font-semibold text-muted-foreground mb-3.5">Docs</div>
        <a href="/docs/" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Getting started</a>
        <a href="/docs/architecture/" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Architecture</a>
        <a href="/docs/permissions/" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Permissions DSL</a>
        <a href="/docs/deployment/" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Deployment</a>
        <a href="/docs/mcp/" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">MCP server</a>
      </div>
      <div>
        <div class="text-[11px] uppercase tracking-wider font-semibold text-muted-foreground mb-3.5">Project</div>
        <a href="https://github.com/backlex/backlex" target="_blank" rel="noopener" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">GitHub</a>
        <a href="/docs/sdk-and-cli/" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">SDK + CLI</a>
        <a href="https://github.com/backlex/backlex/releases" target="_blank" rel="noopener" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Changelog</a>
        <a href="https://github.com/backlex/backlex/blob/main/LICENSE" target="_blank" rel="noopener" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">License (Apache-2.0)</a>
        <a href="/terms" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Terms of Service</a>
        <a href="/privacy" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Privacy · DPA</a>
        <a href="/refund" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Refund Policy</a>
      </div>
    </div>
    <div class="mt-12 pt-6 border-t border-border flex items-center justify-between gap-3.5 flex-wrap text-xs text-muted-foreground">
      <span>© 2026 backlex · open source core, managed cloud on Cloudflare</span>
      <div class="flex items-center gap-3.5">
        <div class="flex items-center gap-2">
          <a href="/privacy" class="hover:text-foreground no-underline">Privacy</a>
          <span class="text-border">·</span>
          <a href="/terms" class="hover:text-foreground no-underline">Terms</a>
          <span class="text-border">·</span>
          <a href="/refund" class="hover:text-foreground no-underline">Refunds</a>
          <span class="text-border">·</span>
          <a href="https://github.com/backlex/backlex/security/policy" target="_blank" rel="noopener" class="hover:text-foreground no-underline">Security</a>
        </div>
      </div>
    </div>
  </div>
</footer>
