---
// Shared footer — mirrors the homepage's 5-column layout.
---
<footer class="relative z-[1] pt-16 pb-12 bg-muted border-t border-border">
  <div class="max-w-[1240px] mx-auto px-8 max-md:px-5">
    <div class="grid grid-cols-[1.4fr_repeat(4,1fr)] max-[1020px]:grid-cols-[1.4fr_repeat(2,1fr)] max-md:grid-cols-2 gap-10 max-md:gap-7">
      <div>
        <a href="/" class="inline-flex items-center gap-2.5 font-semibold text-[15px] -tracking-[0.01em] text-foreground no-underline">
          <span class="w-7 h-7 bg-primary text-primary-foreground rounded-md grid place-items-center font-bold text-base leading-none">b</span>
          <span>backlex</span>
        </a>
        <p class="text-muted-foreground mt-4 text-[13.5px] max-w-[36ch] leading-snug">An edge-native backend platform. Dynamic schema, permissions DSL, realtime, edge functions — one codebase on Bun, Workers, Vercel, and Netlify.</p>
        <div class="mt-4 flex items-center gap-2">
          <span class="font-mono text-[10.5px] px-2 py-0.5 bg-background border border-border rounded-full text-muted-foreground">MIT core</span>
          <span class="font-mono text-[10.5px] px-2 py-0.5 bg-background border border-border rounded-full text-muted-foreground">cloud · private beta</span>
        </div>
      </div>
      <div>
        <div class="text-[11px] uppercase tracking-wider font-semibold text-muted-foreground mb-3.5">Product</div>
        <a href="/#features" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Features</a>
        <a href="/#deploy" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Deploy targets</a>
        <a href="/#global" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Global edge</a>
        <a href="/#ai" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">AI · MCP</a>
        <a href="/#stack" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Stack</a>
        <a href="https://cloud.backlex.com" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Open Cloud</a>
      </div>
      <div>
        <div class="text-[11px] uppercase tracking-wider font-semibold text-muted-foreground mb-3.5">Cloud</div>
        <a href="/#cloud" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Why Cloud</a>
        <a href="/pricing" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Pricing</a>
        <a href="/enterprise" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Enterprise</a>
        <a href="https://cloud.backlex.com" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Cloud admin</a>
        <a href="#" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Status</a>
      </div>
      <div>
        <div class="text-[11px] uppercase tracking-wider font-semibold text-muted-foreground mb-3.5">Docs</div>
        <a href="/docs#getting-started" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Getting started</a>
        <a href="/docs#architecture" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Architecture</a>
        <a href="/docs#permissions" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Permissions DSL</a>
        <a href="/docs#deployment" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Deployment</a>
        <a href="/docs#mcp" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">MCP server</a>
      </div>
      <div>
        <div class="text-[11px] uppercase tracking-wider font-semibold text-muted-foreground mb-3.5">Project</div>
        <a href="https://github.com" target="_blank" rel="noopener" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">GitHub</a>
        <a href="/docs#sdk-and-cli" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">SDK + CLI</a>
        <a href="#" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Changelog</a>
        <a href="#" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">License (MIT)</a>
        <a href="#" class="block text-foreground no-underline text-[13.5px] py-1 hover:text-primary">Privacy · DPA</a>
      </div>
    </div>
    <div class="mt-12 pt-6 border-t border-border flex items-center justify-between gap-3.5 flex-wrap text-xs text-muted-foreground">
      <span>© 2026 backlex · open source core, managed cloud on Cloudflare</span>
      <div class="flex items-center gap-2">
        <a href="#" class="hover:text-foreground no-underline">Privacy</a>
        <span class="text-border">·</span>
        <a href="#" class="hover:text-foreground no-underline">Terms</a>
        <span class="text-border">·</span>
        <a href="#" class="hover:text-foreground no-underline">Security</a>
      </div>
    </div>
  </div>
</footer>
