---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BeamsBackground from "../components/BeamsBackground.astro";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  showChrome?: boolean;
  showBeams?: boolean;
}

const {
  title,
  description = "Code your backend with AI and deploy it globally. A full backend — dynamic schema, permissions DSL, REST + GraphQL, realtime, vector search — with a built-in MCP server so AI agents build and run it for you. One codebase on your own server (Bun, Node, or Deno), Docker, Cloudflare Workers, Vercel, Netlify, or Deno Deploy. Self-host or use the managed Cloud.",
  bodyClass = "",
  showChrome = true,
  showBeams = true,
} = Astro.props;

// Canonical absolute URL for this page (Astro.site = https://backlex.com).
// With `build.format: "file"` the pathname carries a `.html` suffix
// (`/pricing.html`); strip it (and `index.html` for `/`) so the canonical
// matches the slash-free URL Cloudflare actually serves and the sitemap emits.
const cleanPath = Astro.url.pathname.replace(/(?:index)?\.html$/, "");
const canonical = new URL(cleanPath || "/", Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Open Graph / Twitter — used by social cards and some LLM crawlers. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="backlex" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Apply theme before paint to avoid a flash.
      try {
        var t =
          localStorage.getItem("backlex.theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        if (t === "dark") document.documentElement.classList.add("dark");
      } catch (_) {}
    </script>
  </head>
  <body class={`bg-background text-foreground font-sans antialiased leading-relaxed ${bodyClass}`}>
    {showBeams && <BeamsBackground />}
    {showChrome && <Nav />}
    <slot />
    {showChrome && <Footer />}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        var sun = btn.querySelector(".ic-sun");
        var moon = btn.querySelector(".ic-moon");
        function applyTheme(t) {
          root.classList.toggle("dark", t === "dark");
          if (sun) sun.classList.toggle("hidden", t === "dark");
          if (moon) moon.classList.toggle("hidden", t !== "dark");
        }
        applyTheme(root.classList.contains("dark") ? "dark" : "light");
        btn.addEventListener("click", function () {
          var next = root.classList.contains("dark") ? "light" : "dark";
          try {
            localStorage.setItem("backlex.theme", next);
          } catch (_) {}
          applyTheme(next);
        });
      })();
    </script>
  </body>
</html>
