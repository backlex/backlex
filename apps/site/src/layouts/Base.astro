---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BeamsBackground from "../components/BeamsBackground.astro";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  showChrome?: boolean;
  showBeams?: boolean;
}

const {
  title,
  description = "Code your backend with AI and deploy it globally. A full backend — dynamic schema, permissions DSL, REST + GraphQL, realtime, vector search — with a built-in MCP server so AI agents build and run it for you. One codebase on your own server (Bun, Node, or Deno), Docker, Cloudflare Workers, Vercel, Netlify, AWS Lambda, Google Cloud & Azure Functions, or Deno Deploy. Self-host or use the managed Cloud.",
  bodyClass = "",
  showChrome = true,
  showBeams = true,
} = Astro.props;

// Canonical absolute URL for this page (Astro.site = https://backlex.com).
// With `build.format: "file"` the pathname carries a `.html` suffix
// (`/pricing.html`); strip it (and `index.html` for `/`) so the canonical
// matches the slash-free URL Cloudflare actually serves and the sitemap emits.
const cleanPath = Astro.url.pathname.replace(/(?:index)?\.html$/, "");
const canonical = new URL(cleanPath || "/", Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#7c5cff" />
    <meta name="theme-color" content="#06050d" />
    <!-- Open Graph / Twitter — used by social cards and some LLM crawlers. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="backlex" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // The cosmos redesign is a dark-only space theme — always dark, no toggle.
      // Re-apply after every client-side view transition (astro:after-swap),
      // otherwise ClientRouter restores the server HTML's <html> (no .dark) and
      // the page flashes to light on internal navigations (e.g. logo click).
      document.documentElement.classList.add("dark");
      document.addEventListener("astro:after-swap", function () {
        document.documentElement.classList.add("dark");
      });
    </script>
    <!-- Smooth cross-page morphs (fade/slide) on client-side navigation. -->
    <ClientRouter />
    <script is:inline>
      // The Starlight docs at /docs are a SEPARATE Astro app. If ClientRouter
      // client-side-swaps them in, their init scripts (Pagefind search, theme,
      // etc.) never run, so e.g. the docs search modal opens empty until a
      // manual refresh. Force a full browser navigation for every /docs link so
      // the docs app always loads cleanly. (Marketing-internal links keep the
      // smooth view transitions.) The listener lives on the persistent
      // document, so it re-stamps after every client-side navigation too.
      (function () {
        function markDocsLinks() {
          document
            .querySelectorAll('a[href^="/docs"]:not([data-astro-reload])')
            .forEach(function (a) {
              a.setAttribute("data-astro-reload", "");
            });
        }
        document.addEventListener("astro:page-load", markDocsLinks);
      })();
    </script>
  </head>
  <body class={`bg-background text-foreground font-sans antialiased leading-relaxed ${bodyClass}`}>
    {showBeams && <BeamsBackground />}
    {showChrome && <Nav />}
    <slot />
    {showChrome && <Footer />}
    <div id="cosmos-cursor" transition:persist aria-hidden="true"></div>
    <script is:inline>
      // Cosmos custom cursor — a mint ring that trails the pointer and swells
      // over interactive targets. Pointer-fine only; hidden on touch / reduced
      // motion.
      //
      // State lives on `window` and the animation loop re-resolves the current
      // #cosmos-cursor element every frame, so the cursor survives
      // <ClientRouter /> view transitions (clicking the logo → home, navigating
      // to /pricing, …) instead of freezing on the detached pre-swap node.
      // `transition:persist` keeps the same element for a seamless handoff; the
      // window guard makes the script idempotent if it re-runs after a swap.
      (function () {
        if (window.__cosmosCursor) return;
        var fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var dot = function () { return document.getElementById("cosmos-cursor"); };
        if (!fine || reduce) {
          window.__cosmosCursor = true;
          var hide = function () { var d = dot(); if (d) d.style.display = "none"; };
          hide();
          document.addEventListener("astro:page-load", hide);
          return;
        }
        // Smooth trailing follow (design LERP 0.18), like the site mockup.
        var S = (window.__cosmosCursor = {
          mx: window.innerWidth / 2, my: window.innerHeight / 2,
          cx: window.innerWidth / 2, cy: window.innerHeight / 2, shown: false,
        });
        window.addEventListener("mousemove", function (e) {
          S.mx = e.clientX; S.my = e.clientY; S.shown = true;
        });
        document.addEventListener("mouseover", function (e) {
          var t = e.target;
          var interactive =
            t && t.closest && t.closest('a,button,[role="button"],input,textarea,select,summary,label,.cosmos-hot');
          var d = dot();
          if (d) d.classList.toggle("is-hot", !!interactive);
        });
        // Switching apps (alt-tab) or tabs leaves the ring frozen at opacity 1
        // while the OS repaints its own cursor, so both show at once. Reset
        // `shown` on blur / tab-hide; the next mousemove re-shows the ring and
        // the loop re-hides the native cursor via `cursor: none`.
        function hideCursor() { S.shown = false; }
        document.addEventListener("mouseleave", hideCursor);
        window.addEventListener("blur", hideCursor);
        document.addEventListener("visibilitychange", function () {
          if (document.hidden) hideCursor();
        });
        (function loop() {
          S.cx += (S.mx - S.cx) * 0.18;
          S.cy += (S.my - S.cy) * 0.18;
          var d = dot();
          if (d) {
            d.style.transform = "translate(" + S.cx + "px," + S.cy + "px)";
            d.style.opacity = S.shown ? "1" : "0";
          }
          requestAnimationFrame(loop);
        })();
      })();
    </script>
  </body>
</html>
