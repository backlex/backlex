---
import Base from "../layouts/Base.astro";
---
<Base title="workeros Cloud — admin" bodyClass="admin-page" showChrome={false} showBeams={false}>

<div class="app-shell">

  <!-- ─────── Topbar ─────── -->
  <header class="border-b border-border bg-background flex items-center gap-3 px-4 sticky top-0 z-30" data-screen-label="Topbar">
    <a href="/" class="inline-flex items-center gap-2 font-semibold text-[14px] -tracking-[0.01em] text-foreground no-underline">
      <span class="w-6 h-6 bg-primary text-primary-foreground rounded-md grid place-items-center font-bold text-[13px] leading-none">w</span>
      <span>workeros</span>
      <span class="font-mono text-[9.5px] uppercase tracking-[0.14em] text-muted-foreground border border-border rounded-full px-1.5 py-0.5">cloud</span>
    </a>

    <span class="text-border">/</span>

    <!-- workspace switcher -->
    <button class="ws-switch inline-flex items-center gap-2 h-8 px-2.5 rounded-md hover:bg-muted text-[13px] font-medium">
      <span class="w-5 h-5 rounded grid place-items-center text-[11px] font-bold text-primary-foreground" style="background: oklch(0.6 0.15 30);">A</span>
      <span>Acme A.Ş.</span>
      <span class="badge badge-primary text-[10px]">Pro</span>
      <span class="badge badge-muted text-[10px] inline-flex items-center gap-1" title="EU + Türkiye data residency (KVKK + GDPR)">
        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        EU
      </span>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground"><polyline points="6 9 12 15 18 9"/></svg>
    </button>

    <!-- search -->
    <div class="relative flex-1 max-w-[400px] ml-3 max-md:hidden">
      <input class="f" placeholder="search projects, members, logs..." style="padding-left: 32px; height: 32px; border-radius: 8px;" />
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground absolute left-2.5 top-1/2 -translate-y-1/2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <span class="absolute right-2 top-1/2 -translate-y-1/2 font-mono text-[10px] text-muted-foreground border border-border rounded px-1 py-0.5">⌘K</span>
    </div>

    <div class="flex-1 max-md:hidden"></div>

    <!-- right side -->
    <a href="#" class="btn btn-ghost btn-sm max-md:hidden" title="Switch to in-project admin">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      <span class="hidden lg:inline">Collections admin</span>
    </a>
    <a class="btn btn-ghost btn-sm max-md:hidden cursor-pointer" data-link="onboarding" title="View getting-started flow">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      <span class="hidden lg:inline">Onboarding</span>
    </a>
    <a href="/docs" class="btn btn-ghost btn-sm max-md:hidden">Docs</a>
    <button id="theme-toggle" title="Theme" class="w-8 h-8 grid place-items-center rounded-md hover:bg-muted text-foreground transition-colors">
      <svg class="ic-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      <svg class="ic-moon hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
    </button>
    <button class="w-8 h-8 grid place-items-center rounded-md hover:bg-muted text-foreground transition-colors relative">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      <span class="absolute top-1.5 right-1.5 w-1.5 h-1.5 rounded-full bg-primary"></span>
    </button>
    <button class="inline-flex items-center gap-2 h-8 px-1.5 pr-2 rounded-md hover:bg-muted text-[12.5px] font-medium">
      <span class="w-6 h-6 rounded-full grid place-items-center text-[11px] font-medium text-primary-foreground" style="background: oklch(0.55 0.13 240);">SK</span>
      <span class="max-lg:hidden">Saadet K.</span>
    </button>
  </header>

  <!-- ─────── Main grid ─────── -->
  <div class="app-grid">
    <!-- ─────── Sidebar ─────── -->
    <aside class="sidebar border-r border-border bg-card overflow-y-auto py-3 px-2.5 flex flex-col" data-screen-label="Sidebar">
      <div class="text-[10px] uppercase tracking-[0.12em] font-medium text-muted-foreground px-2 mb-1.5">Workspace</div>
      <nav class="flex flex-col gap-px">
        <a data-link="ws-overview" class="nav-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Overview
        </a>
        <a data-link="ws-team" class="nav-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Team
          <span class="ml-auto badge badge-muted text-[10px]">12</span>
        </a>
        <a data-link="ws-billing" class="nav-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          Billing
        </a>
        <a data-link="ws-audit" class="nav-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          Audit log
        </a>
        <a data-link="ws-keys" class="nav-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/></svg>
          Deploy keys
          <span class="ml-auto badge badge-muted text-[10px]">5</span>
        </a>
        <a data-link="ws-integrations" class="nav-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 4 4-4 4"/><path d="M2 8h14"/><path d="m12 22-4-4 4-4"/><path d="M22 16H8"/></svg>
          Integrations
        </a>
        <a data-link="ws-settings" class="nav-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.07A1.65 1.65 0 0 0 9 3.09V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.07c.39.16.71.43.94.78l.07.12c.16.39.12.85-.12 1.18Z"/></svg>
          Settings
        </a>
      </nav>

      <div class="nav-section text-[10px] uppercase tracking-[0.12em] font-medium text-muted-foreground px-2 mb-1.5 mt-5">Projects</div>

      <div class="flex flex-col gap-1">
        <!-- acme-prod (active) -->
        <div class="rounded-md bg-muted/40 px-1 pt-1 pb-1.5">
          <div class="flex items-center gap-2 px-1.5 py-1">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-muted-foreground"><polyline points="6 9 12 15 18 9"/></svg>
            <span class="text-[12.5px] font-semibold flex-1 truncate">acme-prod</span>
            <span class="badge badge-primary text-[9.5px]">live</span>
          </div>
          <div class="flex flex-col gap-px ml-2 pl-2.5 border-l border-border">
            <a data-link="proj-overview" class="nav-item"><span class="led"></span>Overview</a>
            <a data-link="proj-usage" class="nav-item"><span class="led"></span>Usage <span class="ml-auto font-mono text-[10px] text-muted-foreground">62%</span></a>
            <a data-link="proj-regions" class="nav-item"><span class="led"></span>Regions <span class="ml-auto font-mono text-[10px] text-muted-foreground">3</span></a>
            <a data-link="proj-backups" class="nav-item"><span class="led"></span>Backups</a>
            <a data-link="proj-domains" class="nav-item"><span class="led"></span>Domains</a>
            <a data-link="proj-branches" class="nav-item"><span class="led"></span>Branches <span class="ml-auto font-mono text-[10px] text-muted-foreground">4</span></a>
            <a data-link="proj-settings" class="nav-item"><span class="led"></span>Settings</a>
            <a href="#" class="nav-item mt-1" style="color: var(--color-primary);" title="Schema, data, auth, functions — go to admin panel">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              <span class="font-medium">Admin panel</span>
              <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="ml-auto"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
            </a>
          </div>
        </div>
        <!-- inactive projects -->
        <a class="nav-item">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-muted-foreground"><polyline points="9 18 15 12 9 6"/></svg>
          <span class="truncate">marketing-site</span>
          <span class="badge badge-muted text-[9.5px] ml-auto">live</span>
        </a>
        <a class="nav-item">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-muted-foreground"><polyline points="9 18 15 12 9 6"/></svg>
          <span class="truncate">staging-api</span>
          <span class="badge badge-amber text-[9.5px] ml-auto">paused</span>
        </a>
        <button class="nav-item text-muted-foreground hover:text-foreground" onclick="openDialog('new-project')">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          New project
        </button>
      </div>

      <!-- footer pinned -->
      <div class="mt-auto pt-3 border-t border-border">
        <div class="px-2 py-1.5 text-[10.5px] text-muted-foreground leading-snug">
          <div class="flex items-center gap-1.5 mb-1"><span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span><span class="font-mono">all systems normal</span></div>
          <div>status.workeros.cloud →</div>
        </div>
        <button class="nav-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Help & docs
        </button>
      </div>
    </aside>

    <!-- ─────── Main content ─────── -->
    <main class="overflow-y-auto">

      <!-- ─────── Workspace · Overview ─────── -->
      <section data-screen="ws-overview" class="is-on" data-screen-label="Workspace · Overview">
        <div class="px-8 max-md:px-5 py-8 max-w-[1400px]">
          <div class="crumbs mb-3"><a>Acme A.Ş.</a><span class="sep">/</span><span class="text-foreground">Overview</span></div>
          <div class="flex items-start justify-between gap-4 flex-wrap mb-6">
            <div>
              <h1 class="text-[26px] font-semibold -tracking-[0.022em] leading-tight">Welcome back, Saadet 👋</h1>
              <p class="text-[13.5px] text-muted-foreground mt-1">3 projects · 8.4M requests in the last 30 days · €38 next invoice</p>
            </div>
            <div class="flex gap-2">
              <button class="btn btn-outline">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export
              </button>
              <button class="btn btn-primary" onclick="openDialog('new-project')">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                New project
              </button>
            </div>
          </div>

          <!-- Stat row -->
          <div class="grid grid-cols-4 max-[920px]:grid-cols-2 max-[480px]:grid-cols-1 gap-3 mb-6">
            <div class="card p-4">
              <div class="text-[11px] uppercase tracking-wider text-muted-foreground">Total requests · 30d</div>
              <div class="text-[22px] font-semibold mt-1 font-mono tabular-nums">8,420,124</div>
              <div class="text-[11px] text-primary mt-0.5">+12% vs last month</div>
              <svg class="spark mt-2 w-full h-8" viewBox="0 0 100 32" preserveAspectRatio="none">
                <path class="area" d="M0,24 L8,20 L16,22 L24,15 L32,18 L40,12 L48,14 L56,8 L64,10 L72,6 L80,9 L88,4 L96,7 L100,5 L100,32 L0,32 Z"/>
                <path d="M0,24 L8,20 L16,22 L24,15 L32,18 L40,12 L48,14 L56,8 L64,10 L72,6 L80,9 L88,4 L96,7 L100,5"/>
              </svg>
            </div>
            <div class="card p-4">
              <div class="text-[11px] uppercase tracking-wider text-muted-foreground">p95 latency</div>
              <div class="text-[22px] font-semibold mt-1 font-mono tabular-nums">52ms</div>
              <div class="text-[11px] text-muted-foreground mt-0.5">EU avg, 3 region</div>
              <div class="mt-2 flex gap-3 text-[10.5px] font-mono text-muted-foreground">
                <span><span class="text-foreground">IST</span> 47ms</span>
                <span><span class="text-foreground">FRA</span> 58ms</span>
                <span><span class="text-foreground">AMS</span> 62ms</span>
              </div>
            </div>
            <div class="card p-4">
              <div class="text-[11px] uppercase tracking-wider text-muted-foreground">Error rate</div>
              <div class="text-[22px] font-semibold mt-1 font-mono tabular-nums">0.08%</div>
              <div class="text-[11px] text-muted-foreground mt-0.5">6,720 / 8.4M</div>
              <div class="mt-2 bar-row" style="height: 32px;">
                <div class="bar" style="--v: 30%"></div>
                <div class="bar" style="--v: 45%"></div>
                <div class="bar" style="--v: 22%"></div>
                <div class="bar" style="--v: 38%"></div>
                <div class="bar" style="--v: 18%"></div>
                <div class="bar" style="--v: 28%"></div>
                <div class="bar" style="--v: 15%"></div>
              </div>
            </div>
            <div class="card p-4">
              <div class="text-[11px] uppercase tracking-wider text-muted-foreground">Next invoice</div>
              <div class="text-[22px] font-semibold mt-1 font-mono tabular-nums">€38.00</div>
              <div class="text-[11px] text-muted-foreground mt-0.5">May 29 · ex. VAT</div>
              <a data-link="ws-billing" class="btn btn-outline btn-sm mt-2 cursor-pointer">Details</a>
            </div>
          </div>

          <!-- Projects grid -->
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-[15.5px] font-semibold -tracking-[0.015em]">Projects</h2>
            <div class="seg">
              <button class="is-on">Grid</button>
              <button>List</button>
            </div>
          </div>
          <div class="grid grid-cols-3 max-[920px]:grid-cols-2 max-[560px]:grid-cols-1 gap-3 mb-8">
            <!-- acme-prod -->
            <a data-link="proj-overview" class="card p-5 cursor-pointer hover:border-foreground/20 transition-colors no-underline text-foreground flex flex-col gap-3">
              <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-md grid place-items-center text-[12px] font-bold text-primary-foreground" style="background: oklch(0.6 0.15 30);">A</span>
                <div class="flex-1">
                  <div class="text-[14px] font-semibold">acme-prod</div>
                  <div class="text-[11px] font-mono text-muted-foreground">acme.workeros.cloud</div>
                </div>
                <span class="badge badge-primary">live</span>
              </div>
              <div class="grid grid-cols-3 gap-2 mt-1">
                <div><div class="text-[10px] uppercase tracking-wider text-muted-foreground">req/30d</div><div class="font-mono text-[13px] font-medium">6.2M</div></div>
                <div><div class="text-[10px] uppercase tracking-wider text-muted-foreground">D1</div><div class="font-mono text-[13px] font-medium">3.2GB</div></div>
                <div><div class="text-[10px] uppercase tracking-wider text-muted-foreground">R2</div><div class="font-mono text-[13px] font-medium">18GB</div></div>
              </div>
              <div class="mt-1 flex items-center gap-2 text-[11px] text-muted-foreground border-t border-border pt-3">
                <span class="font-mono">IST + FRA + AMS · EU</span>
                <span class="ml-auto font-mono">last deploy 2h ago</span>
              </div>
            </a>
            <!-- marketing-site -->
            <a class="card p-5 cursor-pointer hover:border-foreground/20 transition-colors no-underline text-foreground flex flex-col gap-3">
              <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-md grid place-items-center text-[12px] font-bold text-primary-foreground" style="background: oklch(0.55 0.16 280);">M</span>
                <div class="flex-1">
                  <div class="text-[14px] font-semibold">marketing-site</div>
                  <div class="text-[11px] font-mono text-muted-foreground">acme.com</div>
                </div>
                <span class="badge badge-primary">live</span>
              </div>
              <div class="grid grid-cols-3 gap-2 mt-1">
                <div><div class="text-[10px] uppercase tracking-wider text-muted-foreground">req/30d</div><div class="font-mono text-[13px] font-medium">2.1M</div></div>
                <div><div class="text-[10px] uppercase tracking-wider text-muted-foreground">D1</div><div class="font-mono text-[13px] font-medium">120MB</div></div>
                <div><div class="text-[10px] uppercase tracking-wider text-muted-foreground">R2</div><div class="font-mono text-[13px] font-medium">4GB</div></div>
              </div>
              <div class="mt-1 flex items-center gap-2 text-[11px] text-muted-foreground border-t border-border pt-3">
                <span class="font-mono">IST</span>
                <span class="ml-auto font-mono">last deploy 1d ago</span>
              </div>
            </a>
            <!-- staging-api -->
            <a class="card p-5 cursor-pointer hover:border-foreground/20 transition-colors no-underline text-foreground flex flex-col gap-3 opacity-70">
              <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-md grid place-items-center text-[12px] font-bold text-primary-foreground" style="background: oklch(0.5 0.05 240);">S</span>
                <div class="flex-1">
                  <div class="text-[14px] font-semibold">staging-api</div>
                  <div class="text-[11px] font-mono text-muted-foreground">staging.workeros.cloud</div>
                </div>
                <span class="badge badge-amber">paused</span>
              </div>
              <div class="grid grid-cols-3 gap-2 mt-1">
                <div><div class="text-[10px] uppercase tracking-wider text-muted-foreground">req/30d</div><div class="font-mono text-[13px] font-medium">120K</div></div>
                <div><div class="text-[10px] uppercase tracking-wider text-muted-foreground">D1</div><div class="font-mono text-[13px] font-medium">50MB</div></div>
                <div><div class="text-[10px] uppercase tracking-wider text-muted-foreground">R2</div><div class="font-mono text-[13px] font-medium">200MB</div></div>
