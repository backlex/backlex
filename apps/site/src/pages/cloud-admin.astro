<script is:inline>
  // Routing across data-screen sections
  function show(screen) {
    document.querySelectorAll("section[data-screen]").forEach((s) =>
      s.classList.toggle("is-on", s.dataset.screen === screen),
    );
    document.querySelectorAll("[data-link]").forEach((a) =>
      a.classList.toggle("is-active", a.dataset.link === screen),
    );
    document.body.classList.toggle("is-onboarding", screen === "onboarding");
    const main = document.querySelector("main");
    if (main) main.scrollTo({ top: 0 });
    window.scrollTo({ top: 0 });
    if (location.hash !== "#" + screen) history.replaceState(null, "", "#" + screen);
  }
  document.querySelectorAll("[data-link]").forEach((a) => {
    a.addEventListener("click", (e) => {
      e.preventDefault();
      show(a.dataset.link);
    });
  });
  const initScreen = location.hash.slice(1) || "ws-overview";
  if (document.querySelector('section[data-screen="' + initScreen + '"]')) show(initScreen);
  else show("ws-overview");

  // Dialogs
  window.openDialog = function (id) {
    const el = document.getElementById("dlg-" + id);
    if (el) el.hidden = false;
  };
  window.closeDialog = function (id) {
    const el = document.getElementById("dlg-" + id);
    if (el) el.hidden = true;
  };
  document.querySelectorAll(".dialog-overlay").forEach((o) =>
    o.addEventListener("click", (e) => {
      if (e.target === o) o.hidden = true;
    }),
  );

  // Region pins
  (function () {
    const list = document.getElementById("active-regions");
    const REGIONS = {
      IST: { name: "Istanbul", latency: "47ms", role: "primary" },
      FRA: { name: "Frankfurt", latency: "58ms", role: "replica" },
      AMS: { name: "Amsterdam", latency: "62ms", role: "replica" },
      DUB: { name: "Dublin", latency: "—", role: "replica" },
      IAD: { name: "Ashburn", latency: "—", role: "locked" },
      SIN: { name: "Singapore", latency: "—", role: "locked" },
      NRT: { name: "Tokyo", latency: "—", role: "locked" },
      SYD: { name: "Sydney", latency: "—", role: "locked" },
      GRU: { name: "São Paulo", latency: "—", role: "locked" },
      JNB: { name: "Johannesburg", latency: "—", role: "locked" },
    };
    function render() {
      if (!list) return;
      const pinned = [...document.querySelectorAll('.map-pin[aria-pressed="true"]')];
      list.innerHTML = pinned
        .map((p) => {
          const code = p.dataset.region;
          const r = REGIONS[code];
          if (!r) return "";
          return (
            '<div class="flex items-center gap-2 p-2 rounded-md hover:bg-muted/40">' +
            '<span class="w-1.5 h-1.5 rounded-full bg-primary"></span>' +
            '<div class="flex-1"><div class="text-[12.5px] font-medium">' +
            code +
            " · " +
            r.name +
            '</div><div class="text-[10.5px] font-mono text-muted-foreground">' +
            r.role +
            "</div></div>" +
            '<span class="font-mono text-[11px] text-muted-foreground">' +
            r.latency +
            "</span></div>"
          );
        })
        .join("");
      const cnt = document.getElementById("regions-active-count");
      if (cnt) cnt.textContent = pinned.length;
    }
    document.querySelectorAll(".map-pin").forEach((pin) => {
      pin.addEventListener("click", () => {
        const pinnedNow = [...document.querySelectorAll('.map-pin[aria-pressed="true"]')];
        const isOn = pin.getAttribute("aria-pressed") === "true";
        if (!isOn && pinnedNow.length >= 3) {
          alert("Pro tier en fazla 3 region destekler. Scale'e yükselt.");
          return;
        }
        pin.setAttribute("aria-pressed", isOn ? "false" : "true");
        render();
      });
    });
    render();
  })();

  // Onboarding step navigation
  window.goStep = function (n) {
    document.querySelectorAll(".ob-panel").forEach((p) => {
      p.hidden = String(p.dataset.step) !== String(n);
    });
    document.querySelectorAll(".ob-step").forEach((s) => {
      const step = parseInt(s.dataset.step, 10);
      s.classList.toggle("is-active", step === n);
      s.classList.toggle("is-done", step < n);
      const label = s.querySelector("span:nth-child(2)");
      if (label) {
        label.classList.toggle("text-foreground", step <= n);
        label.classList.toggle("text-muted-foreground", step > n);
      }
    });
    const sec = document.querySelector('section[data-screen="onboarding"]');
    if (sec) sec.scrollTo({ top: 0 });
    window.scrollTo({ top: 0 });
  };

  document.querySelectorAll(".ob-radio").forEach((r) => {
    r.addEventListener("click", () => {
      const input = r.querySelector("input");
      if (!input) return;
      const group = input.name;
      if (group) {
        document.querySelectorAll('.ob-radio input[name="' + group + '"]').forEach((i) => {
          const wrap = i.closest(".ob-radio");
          if (wrap) wrap.classList.toggle("is-on", i === input);
        });
      }
    });
  });

  // PITR slider
  (function () {
    const slider = document.getElementById("pitr-slider");
    if (!slider) return;
    const timeEl = document.getElementById("pitr-time");
    const deltaEl = document.getElementById("pitr-delta");
    function update() {
      const v = parseInt(slider.value, 10);
      const minutesBack = Math.round(((100 - v) * (7 * 24 * 60)) / 100);
      const now = new Date("2026-05-25T14:32:00+03:00");
      const t = new Date(now.getTime() - minutesBack * 60 * 1000);
      const d = String(t.getDate()).padStart(2, "0");
      const monthNames = ["Oca", "Şub", "Mar", "Nis", "May", "Haz", "Tem", "Ağu", "Eyl", "Eki", "Kas", "Ara"];
      const month = monthNames[t.getMonth()];
      const h = String(t.getHours()).padStart(2, "0");
      const m = String(t.getMinutes()).padStart(2, "0");
      if (timeEl) timeEl.textContent = d + " " + month + " " + t.getFullYear() + " · " + h + ":" + m + " TRT";
      const days = Math.floor(minutesBack / (24 * 60));
      const hours = Math.floor((minutesBack - days * 24 * 60) / 60);
      if (deltaEl) deltaEl.textContent = days > 0 ? days + " gün, " + hours + " saat önce" : hours + " saat önce";
    }
    slider.addEventListener("input", update);
    update();
  })();
</script>
</Base>
