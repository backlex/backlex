<script is:inline>
  // Routing: which article is open is the URL hash. Defaults to getting-started.
  const ARTICLES = [
    "getting-started", "architecture", "deployment",
    "collections", "adopting-tables", "querying", "graphql",
    "permissions", "auth-planes", "sso",
    "realtime", "storage", "sandbox",
    "sdk-and-cli", "mcp", "advisor",
  ];
  const TITLES = {
    "getting-started": "Getting started",
    "architecture": "Architecture",
    "deployment": "Deployment",
    "collections": "Collections",
    "adopting-tables": "Adopting tables",
    "querying": "Querying items",
    "graphql": "GraphQL",
    "permissions": "Permissions DSL",
    "auth-planes": "Auth planes",
    "sso": "SSO & LDAP",
    "realtime": "Realtime",
    "storage": "Storage",
    "sandbox": "Functions / sandbox",
    "sdk-and-cli": "SDK & CLI",
    "mcp": "MCP server",
    "advisor": "Advisor",
  };

  function showArticle(id) {
    if (!ARTICLES.includes(id)) id = "getting-started";
    document.querySelectorAll("article").forEach((a) => {
      a.classList.toggle("on", a.id === "article-" + id);
    });
    document.querySelectorAll("aside.side a.nav-link").forEach((a) => {
      a.classList.toggle("on", a.getAttribute("href") === "#" + id);
    });
    const crumb = document.getElementById("crumb-title");
    if (crumb) crumb.textContent = TITLES[id] || id;
    document.title = (TITLES[id] || id) + " â backlex docs";
    buildToc(id);
    window.scrollTo(0, 0);
  }

  function buildToc(id) {
    const article = document.getElementById("article-" + id);
    const list = document.getElementById("toc-list");
    if (!list) return;
    if (!article) { list.innerHTML = ""; return; }
    const headings = [...article.querySelectorAll("h2[id], h3[id]")];
    list.innerHTML = headings.map((h) => {
      const lvl = h.tagName.toLowerCase();
      return '<a href="#' + id + '/' + h.id + '" data-target="' + h.id + '" class="' + lvl + '">' + h.textContent + "</a>";
    }).join("");
  }

  function parseHash() {
    const raw = (location.hash || "").replace(/^#/, "");
    const [page, anchor] = raw.split("/");
    return { page: page || "getting-started", anchor: anchor || "" };
  }

  function applyHash() {
    const { page, anchor } = parseHash();
    showArticle(page);
    if (anchor) {
      const el = document.getElementById(anchor);
      if (el) setTimeout(() => el.scrollIntoView({ behavior: "auto", block: "start" }), 50);
    }
  }

  window.addEventListener("hashchange", applyHash);

  document.querySelectorAll("aside.side a.nav-link").forEach((a) => {
    a.addEventListener("click", (e) => {
      e.preventDefault();
      const id = a.getAttribute("href").slice(1);
      location.hash = id;
    });
  });

  document.querySelectorAll("a.in-text[href^='#']").forEach((a) => {
    a.addEventListener("click", (e) => {
      e.preventDefault();
      const id = a.getAttribute("href").slice(1);
      if (ARTICLES.includes(id)) {
        location.hash = id;
      } else {
        const el = document.getElementById(id);
        if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  });

  const tocList = document.getElementById("toc-list");
  if (tocList) {
    tocList.addEventListener("click", (e) => {
      const a = e.target.closest("a");
      if (!a) return;
      e.preventDefault();
      const target = a.dataset.target;
      const el = document.getElementById(target);
      if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
      document.querySelectorAll("#toc-list a").forEach((x) => x.classList.toggle("on", x === a));
    });
  }

  document.querySelectorAll(".doc-footer a").forEach((a) => {
    a.addEventListener("click", (e) => {
      const href = a.getAttribute("href") || "";
      if (!href.startsWith("#")) return;
      e.preventDefault();
      location.hash = href.slice(1);
    });
  });

  window.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      const s = document.getElementById("search-input");
      if (s) s.focus();
    }
  });

  const searchInput = document.getElementById("search-input");
  if (searchInput) {
    searchInput.addEventListener("input", (e) => {
      const q = e.target.value.toLowerCase().trim();
      document.querySelectorAll("aside.side a.nav-link").forEach((a) => {
        const match = !q || a.textContent.toLowerCase().includes(q);
        a.style.display = match ? "" : "none";
      });
    });
  }

  applyHash();
</script>
