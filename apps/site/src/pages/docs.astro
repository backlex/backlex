      <h2 id="client">@backlex/client</h2>
      <p>Typed fetch wrapper, browser + Node.</p>
      <div class="codeblock"><div class="head"><span class="dot"></span>typescript</div><pre><span class="c-kw">import</span> &#123; createClient &#125; <span class="c-kw">from</span> <span class="c-str">"@backlex/client"</span>;

<span class="c-kw">const</span> wks = <span class="c-fn">createClient</span>(&#123;
  url: <span class="c-str">"https://api.your.app"</span>,
  <span class="c-comment">// For server-to-server / CI; browser apps use the cookie session:</span>
  apiKey: process.env.BACKLEX_API_KEY,
&#125;);

<span class="c-comment">// CRUD</span>
<span class="c-kw">const</span> list = <span class="c-kw">await</span> wks.<span class="c-fn">from</span>&lt;Posts&gt;(<span class="c-str">"posts"</span>).<span class="c-fn">list</span>(&#123;
  filter: &#123; published: &#123; _eq: <span class="c-num">true</span> &#125; &#125;,
  sort:   [<span class="c-str">"-views"</span>, <span class="c-str">"title"</span>],
  fields: [<span class="c-str">"id"</span>, <span class="c-str">"title"</span>, <span class="c-str">"views"</span>],
  limit:  <span class="c-num">25</span>,
  meta:   <span class="c-str">"filter_count"</span>,
&#125;);

<span class="c-kw">const</span> one     = <span class="c-kw">await</span> wks.<span class="c-fn">from</span>&lt;Posts&gt;(<span class="c-str">"posts"</span>).<span class="c-fn">one</span>(<span class="c-str">"uuid"</span>);
<span class="c-kw">const</span> created = <span class="c-kw">await</span> wks.<span class="c-fn">from</span>&lt;Posts&gt;(<span class="c-str">"posts"</span>).<span class="c-fn">create</span>(&#123; title: <span class="c-str">"hi"</span> &#125;);
<span class="c-kw">await</span> wks.<span class="c-fn">from</span>&lt;Posts&gt;(<span class="c-str">"posts"</span>).<span class="c-fn">update</span>(<span class="c-str">"uuid"</span>, &#123; views: <span class="c-num">42</span> &#125;);
<span class="c-kw">await</span> wks.<span class="c-fn">from</span>&lt;Posts&gt;(<span class="c-str">"posts"</span>).<span class="c-fn">delete</span>(<span class="c-str">"uuid"</span>);

<span class="c-comment">// Realtime (SSE)</span>
<span class="c-kw">const</span> off = wks.<span class="c-fn">subscribe</span>&lt;Posts&gt;(<span class="c-str">"items:posts"</span>, (e) =&gt; &#123;
  <span class="c-fn">console.log</span>(e.event, e.data);
&#125;);

<span class="c-comment">// Storage</span>
<span class="c-kw">await</span> wks.storage.<span class="c-fn">put</span>(<span class="c-str">"avatars/me.png"</span>, file, <span class="c-str">"image/png"</span>);</pre></div>

