    <article id="article-deployment">
      <div class="frontmatter">
        <span class="eyebrow"><span class="dot"></span>Start here</span>
        <h1>Deployment</h1>
        <p class="desc">Ship the same source to Bun, Cloudflare Workers, Vercel, or Netlify.</p>
