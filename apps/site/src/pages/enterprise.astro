---
import Base from "../layouts/Base.astro";
---
<Base title="workeros Cloud — enterprise">

<!-- ─────────────────── Hero ─────────────────── -->
<section class="relative pt-24 pb-16 border-b border-border overflow-hidden"
  style="background: radial-gradient(60% 80% at 50% 0%, var(--color-tint), transparent 70%);">
  <div class="relative max-w-[1240px] mx-auto px-8 max-md:px-5 grid grid-cols-2 max-[860px]:grid-cols-1 gap-12 items-center">
    <div>
      <span class="inline-flex items-center gap-2 font-mono text-[11px] text-muted-foreground uppercase tracking-[0.12em] whitespace-nowrap border border-border rounded-full px-3 py-1.5 bg-muted">
        <span class="w-1.5 h-1.5 bg-primary rounded-full"></span>
        <span data-tr="enterprise · single-tenant" data-en="enterprise · single-tenant">enterprise · single-tenant</span>
      </span>
      <h1 class="font-semibold -tracking-[0.038em] leading-[1.05] text-[clamp(36px,5vw,58px)] mt-5" data-tr="Vendor review'ı geçecek <span class='text-primary dark:text-[oklch(0.82_0.22_131)]'>bir backend</span>." data-en="A <span class='text-primary dark:text-[oklch(0.82_0.22_131)]'>backend</span> that passes vendor review.">Vendor review'ı geçecek <span class="text-primary dark:text-[oklch(0.82_0.22_131)]">bir backend</span>.</h1>
      <p class="text-[17px] text-muted-foreground mt-5 leading-snug max-w-[52ch]" data-tr="SAML SSO, SCIM, SOC 2, dedicated cluster, KVKK için TR-pin. Mühendislik ekibin için workeros'un esnekliği, hukuk ve güvenlik için kurumsal sözleşme zırhı." data-en="SAML SSO, SCIM, SOC 2, dedicated cluster, TR-pin for KVKK. workeros's flexibility for engineering, contractual armor for legal and security.">SAML SSO, SCIM, SOC 2, dedicated cluster, KVKK için TR-pin. Mühendislik ekibin için workeros'un esnekliği, hukuk ve güvenlik için kurumsal sözleşme zırhı.</p>
      <div class="flex gap-2.5 mt-6 flex-wrap">
        <a href="#contact" class="inline-flex items-center gap-2 h-11 px-5 rounded-4xl bg-primary text-primary-foreground text-[14.5px] font-medium no-underline hover:bg-[color-mix(in_oklch,var(--color-primary)_90%,var(--color-foreground))] transition-colors whitespace-nowrap" data-tr="Görüşme planla →" data-en="Book a call →">Görüşme planla →</a>
        <a href="#trust" class="inline-flex items-center gap-2 h-11 px-5 rounded-4xl border border-border bg-background hover:bg-muted text-foreground text-[14.5px] font-medium no-underline transition-colors whitespace-nowrap" data-tr="Güvenlik & uyum" data-en="Security & compliance">Güvenlik & uyum</a>
      </div>
      <div class="mt-7 flex items-center gap-5 flex-wrap text-[11.5px] text-muted-foreground">
        <span class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-primary"></span>SAML 2.0</span>
        <span class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-primary"></span>SCIM 2.0</span>
        <span class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-primary"></span>SOC 2 <span class="text-muted-foreground/70">(<span data-tr="sürmekte" data-en="in progress">sürmekte</span>)</span></span>
        <span class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-primary"></span>GDPR · KVKK</span>
        <span class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-primary"></span>99.99% SLA</span>
      </div>
    </div>

    <!-- Vendor checklist preview -->
    <div class="relative border border-border rounded-3xl bg-card overflow-hidden shadow-[0_24px_48px_-16px_oklch(0_0_0/0.1)]">
      <div class="px-5 py-3 border-b border-border bg-muted flex items-center gap-2">
        <span class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider" data-tr="satıcı değerlendirme — workeros" data-en="vendor review — workeros">satıcı değerlendirme — workeros</span>
        <span class="ml-auto cf-pill"><span class="w-1.5 h-1.5 rounded-full bg-primary"></span>12 / 12</span>
      </div>
      <div class="divide-y divide-border text-[13px]">
        <div class="px-5 py-2.5 flex items-center gap-3"><span class="text-primary">✓</span><span class="flex-1" data-tr="SSO (SAML 2.0) — Okta, AAD, Google" data-en="SSO (SAML 2.0) — Okta, AAD, Google">SSO (SAML 2.0) — Okta, AAD, Google</span><span class="font-mono text-[11px] text-muted-foreground">P0</span></div>
        <div class="px-5 py-2.5 flex items-center gap-3"><span class="text-primary">✓</span><span class="flex-1" data-tr="SCIM provisioning ve deprovisioning" data-en="SCIM provisioning and deprovisioning">SCIM provisioning ve deprovisioning</span><span class="font-mono text-[11px] text-muted-foreground">P0</span></div>
        <div class="px-5 py-2.5 flex items-center gap-3"><span class="text-primary">✓</span><span class="flex-1" data-tr="Şifrelenmiş veri (transit + rest)" data-en="Encryption (in-transit + at-rest)">Şifrelenmiş veri (transit + rest)</span><span class="font-mono text-[11px] text-muted-foreground">P0</span></div>
        <div class="px-5 py-2.5 flex items-center gap-3"><span class="text-primary">✓</span><span class="flex-1" data-tr="Audit log + IP allowlist" data-en="Audit log + IP allowlist">Audit log + IP allowlist</span><span class="font-mono text-[11px] text-muted-foreground">P0</span></div>
        <div class="px-5 py-2.5 flex items-center gap-3"><span class="text-primary">✓</span><span class="flex-1" data-tr="DPA (KVKK / GDPR uyumlu)" data-en="DPA (KVKK / GDPR compliant)">DPA (KVKK / GDPR uyumlu)</span><span class="font-mono text-[11px] text-muted-foreground">P0</span></div>
        <div class="px-5 py-2.5 flex items-center gap-3"><span class="text-primary">✓</span><span class="flex-1" data-tr="MSA — redline destekli" data-en="MSA — supports redlines">MSA — redline destekli</span><span class="font-mono text-[11px] text-muted-foreground">P1</span></div>
        <div class="px-5 py-2.5 flex items-center gap-3"><span class="text-primary">✓</span><span class="flex-1" data-tr="Veri yerelliği — TR region pin" data-en="Data residency — TR region pin">Veri yerelliği — TR region pin</span><span class="font-mono text-[11px] text-muted-foreground">P1</span></div>
        <div class="px-5 py-2.5 flex items-center gap-3"><span class="text-primary">✓</span><span class="flex-1" data-tr="Pen-test raporu (yıllık)" data-en="Pen-test report (annual)">Pen-test raporu (yıllık)</span><span class="font-mono text-[11px] text-muted-foreground">P1</span></div>
        <div class="px-5 py-2.5 flex items-center gap-3"><span class="text-primary">✓</span><span class="flex-1" data-tr="Backup + DR plan" data-en="Backup + DR plan">Backup + DR plan</span><span class="font-mono text-[11px] text-muted-foreground">P1</span></div>
        <div class="px-5 py-2.5 flex items-center gap-3"><span class="text-primary">✓</span><span class="flex-1" data-tr="Vendor security questionnaire (CAIQ)" data-en="Vendor security questionnaire (CAIQ)">Vendor security questionnaire (CAIQ)</span><span class="font-mono text-[11px] text-muted-foreground">P2</span></div>
        <div class="px-5 py-2.5 flex items-center gap-3"><span class="text-primary">✓</span><span class="flex-1" data-tr="Cyber insurance kapsamı" data-en="Cyber insurance coverage">Cyber insurance kapsamı</span><span class="font-mono text-[11px] text-muted-foreground">P2</span></div>
        <div class="px-5 py-2.5 flex items-center gap-3"><span class="text-primary">✓</span><span class="flex-1" data-tr="Vendor risk profili (low)" data-en="Vendor risk profile (low)">Vendor risk profili (low)</span><span class="font-mono text-[11px] text-muted-foreground">P2</span></div>
      </div>
      <div class="px-5 py-3 border-t border-border bg-muted/60 flex items-center gap-2 text-[11.5px] text-muted-foreground">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span data-tr="ortalama vendor review süresi — 11 iş günü" data-en="average vendor review — 11 business days">ortalama vendor review süresi — 11 iş günü</span>
        <span class="ml-auto font-mono">2026 Q1</span>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────── Three pillars ─────────────────── -->
<section id="trust" class="py-20 border-b border-border">
  <div class="max-w-[1240px] mx-auto px-8 max-md:px-5">
    <div class="flex flex-col gap-4 max-w-[720px] mb-12">
      <span class="inline-flex items-center gap-2 font-mono text-[11px] text-muted-foreground uppercase tracking-[0.12em] whitespace-nowrap self-start"><span class="w-1.5 h-1.5 bg-primary rounded-full"></span><span data-tr="kurumsal sütunlar" data-en="enterprise pillars">kurumsal sütunlar</span></span>
      <h2 class="text-[clamp(28px,3.4vw,38px)] font-semibold -tracking-[0.026em] leading-[1.12]" data-tr="Kimlik, uyumluluk, izolasyon. Her birine ayrı bir cevap." data-en="Identity, compliance, isolation. A clear answer for each.">Kimlik, uyumluluk, izolasyon. Her birine ayrı bir cevap.</h2>
    </div>

    <div class="grid grid-cols-3 max-[920px]:grid-cols-1 gap-3.5">

      <!-- Identity -->
      <div class="border border-border rounded-3xl bg-card p-7 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <span class="w-10 h-10 rounded-2xl bg-muted grid place-items-center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
          <h3 class="text-[19px] font-semibold -tracking-[0.018em]" data-tr="Kimlik" data-en="Identity">Kimlik</h3>
        </div>
        <p class="text-[13.5px] text-muted-foreground leading-snug" data-tr="Tek bir SSO sağlayıcısına bağlanır, takım üyeleri buradan gelir, gitmez. SCIM ile IDP'den deprovision olduğunda erişim aynı dakika kapanır." data-en="Connects to a single SSO provider; team members come from there. SCIM revokes access the moment IDP deprovisions.">Tek bir SSO sağlayıcısına bağlanır, takım üyeleri buradan gelir, gitmez. SCIM ile IDP'den deprovision olduğunda erişim aynı dakika kapanır.</p>
        <ul class="text-[12.5px] text-muted-foreground space-y-1.5 list-none p-0 mt-1">
          <li class="flex gap-2"><span class="text-primary">✓</span>SAML 2.0 — Okta · Azure AD · Google · JumpCloud · OneLogin</li>
          <li class="flex gap-2"><span class="text-primary">✓</span>SCIM 2.0 user + group provisioning</li>
          <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="Just-in-time provisioning, IDP attribute mapping" data-en="JIT provisioning, IDP attribute mapping">Just-in-time provisioning, IDP attribute mapping</span></li>
          <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="Multi-IDP — yan kuruluşlar için ayrı sağlayıcı" data-en="Multi-IDP — separate provider per subsidiary">Multi-IDP — yan kuruluşlar için ayrı sağlayıcı</span></li>
          <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="Workspace düzeyinde RBAC" data-en="Workspace-level RBAC">Workspace düzeyinde RBAC</span></li>
        </ul>
      </div>

      <!-- Compliance -->
      <div class="border border-border rounded-3xl bg-card p-7 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <span class="w-10 h-10 rounded-2xl bg-muted grid place-items-center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></span>
          <h3 class="text-[19px] font-semibold -tracking-[0.018em]" data-tr="Uyumluluk" data-en="Compliance">Uyumluluk</h3>
        </div>
        <p class="text-[13.5px] text-muted-foreground leading-snug" data-tr="Vendor questionnaire'in ne sorduğunu biliyoruz — cevaplar bir paket halinde, redline alabileceğin sözleşmelerle birlikte. NDA imzaladığımız anda CAIQ ve pen-test raporu Drive'da." data-en="We know the vendor questionnaire — answers come in a package with redline-able contracts. CAIQ and pen-test report shared on NDA.">Vendor questionnaire'in ne sorduğunu biliyoruz — cevaplar bir paket halinde, redline alabileceğin sözleşmelerle birlikte. NDA imzaladığımız anda CAIQ ve pen-test raporu Drive'da.</p>
        <ul class="text-[12.5px] text-muted-foreground space-y-1.5 list-none p-0 mt-1">
          <li class="flex gap-2"><span class="text-primary">✓</span>SOC 2 Type II <span class="text-muted-foreground" data-tr="(sürmekte, 2026 Q3)" data-en="(in progress, 2026 Q3)">(sürmekte, 2026 Q3)</span></li>
          <li class="flex gap-2"><span class="text-primary">✓</span>GDPR — EU temsilcisi atanmış</li>
          <li class="flex gap-2"><span class="text-primary">✓</span>KVKK — TR mukim, e-fatura, KVK Kurulu kaydı</li>
          <li class="flex gap-2"><span class="text-primary">✓</span>DPA + SCC <span data-tr="hazır taslak" data-en="ready template">hazır taslak</span></li>
          <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="MSA redline destekli — 5 iş günü" data-en="MSA supports redlines — 5 business days">MSA redline destekli — 5 iş günü</span></li>
          <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="Yıllık 3. parti pen-test" data-en="Annual 3rd-party pen-test">Yıllık 3. parti pen-test</span></li>
        </ul>
      </div>

      <!-- Isolation -->
      <div class="border border-border rounded-3xl bg-card p-7 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <span class="w-10 h-10 rounded-2xl bg-muted grid place-items-center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M3 9h18"/></svg></span>
          <h3 class="text-[19px] font-semibold -tracking-[0.018em]" data-tr="İzolasyon" data-en="Isolation">İzolasyon</h3>
        </div>
        <p class="text-[13.5px] text-muted-foreground leading-snug" data-tr="Single-tenant cluster — sadece senin için bir Cloudflare hesabı + D1 + R2. KVKK'ya uyman gerekiyorsa primary'yi Istanbul'a pinleriz; backup'lar da TR'de durur." data-en="Single-tenant cluster — your own Cloudflare account + D1 + R2. KVKK? We pin primary to Istanbul; backups stay in TR.">Single-tenant cluster — sadece senin için bir Cloudflare hesabı + D1 + R2. KVKK'ya uyman gerekiyorsa primary'yi Istanbul'a pinleriz; backup'lar da TR'de durur.</p>
        <ul class="text-[12.5px] text-muted-foreground space-y-1.5 list-none p-0 mt-1">
          <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="Dedicated CF hesap + workeros instance" data-en="Dedicated CF account + workeros instance">Dedicated CF hesap + workeros instance</span></li>
          <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="Region pin (IST, FRA, IAD, SYD, GRU)" data-en="Region pin (IST, FRA, IAD, SYD, GRU)">Region pin (IST, FRA, IAD, SYD, GRU)</span></li>
          <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="Müşteri-yönetimli encryption key (BYOK)" data-en="Customer-managed encryption key (BYOK)">Müşteri-yönetimli encryption key (BYOK)</span></li>
          <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="VPC-style erişim — IP allowlist + mTLS" data-en="VPC-style access — IP allowlist + mTLS">VPC-style erişim — IP allowlist + mTLS</span></li>
          <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="Bring-your-own-domain — kendi sertifikan" data-en="Bring-your-own-domain — your own cert">Bring-your-own-domain — kendi sertifikan</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────── SLA ─────────────────── -->
<section class="py-20 border-b border-border bg-muted/40">
  <div class="max-w-[1240px] mx-auto px-8 max-md:px-5">
    <div class="grid grid-cols-2 max-[820px]:grid-cols-1 gap-12 items-start">
      <div>
        <span class="inline-flex items-center gap-2 font-mono text-[11px] text-muted-foreground uppercase tracking-[0.12em] whitespace-nowrap"><span class="w-1.5 h-1.5 bg-primary rounded-full"></span>SLA · <span data-tr="kredi politikası" data-en="credit policy">kredi politikası</span></span>
        <h2 class="text-[clamp(24px,3vw,32px)] font-semibold -tracking-[0.022em] leading-[1.15] mt-4 max-w-[20ch]" data-tr="Söz değil, sayı. Aşıldığında kredi." data-en="Numbers, not promises. Credits when missed.">Söz değil, sayı. Aşıldığında kredi.</h2>
        <p class="text-[15px] text-muted-foreground mt-3 max-w-[44ch]" data-tr="99.99% uptime garantisi. Hedef altında geçen her dakika için faturadan otomatik kredi düşülür — talep etmene gerek yok." data-en="99.99% uptime target. Every minute below earns automatic credit — no claim form needed.">99.99% uptime garantisi. Hedef altında geçen her dakika için faturadan otomatik kredi düşülür — talep etmene gerek yok.</p>
        <a href="#contact" class="inline-flex items-center gap-2 h-10 px-4 mt-5 rounded-3xl bg-primary text-primary-foreground text-[13.5px] font-medium no-underline hover:bg-[color-mix(in_oklch,var(--color-primary)_90%,var(--color-foreground))] transition-colors whitespace-nowrap" data-tr="SLA örneği iste →" data-en="Request sample SLA →">SLA örneği iste →</a>
      </div>
      <div class="border border-border rounded-3xl bg-card overflow-hidden">
        <table class="w-full border-collapse text-[13.5px]">
          <thead>
            <tr class="bg-muted">
              <th class="px-5 py-3 text-left font-medium text-[11px] uppercase tracking-wider text-muted-foreground border-b border-border" data-tr="Uptime ölçümü" data-en="Uptime measured">Uptime ölçümü</th>
              <th class="px-5 py-3 text-left font-medium text-[11px] uppercase tracking-wider text-muted-foreground border-b border-border" data-tr="Kredi" data-en="Credit">Kredi</th>
              <th class="px-5 py-3 text-left font-medium text-[11px] uppercase tracking-wider text-muted-foreground border-b border-border" data-tr="Aylık fatura indirimi" data-en="Monthly bill discount">Aylık fatura indirimi</th>
            </tr>
          </thead>
          <tbody>
            <tr><td class="px-5 py-3 border-b border-border font-medium">≥ 99.99%</td><td class="px-5 py-3 border-b border-border text-muted-foreground" data-tr="hedefte" data-en="on target">hedefte</td><td class="px-5 py-3 border-b border-border font-mono">—</td></tr>
            <tr><td class="px-5 py-3 border-b border-border font-medium">99.95% – 99.99%</td><td class="px-5 py-3 border-b border-border" data-tr="10% kredi" data-en="10% credit">10% kredi</td><td class="px-5 py-3 border-b border-border font-mono">-10%</td></tr>
            <tr><td class="px-5 py-3 border-b border-border font-medium">99.90% – 99.95%</td><td class="px-5 py-3 border-b border-border" data-tr="25% kredi" data-en="25% credit">25% kredi</td><td class="px-5 py-3 border-b border-border font-mono">-25%</td></tr>
            <tr><td class="px-5 py-3 font-medium">&lt; 99.90%</td><td class="px-5 py-3" data-tr="50% kredi" data-en="50% credit">50% kredi</td><td class="px-5 py-3 font-mono">-50%</td></tr>
          </tbody>
        </table>
        <div class="px-5 py-3 border-t border-border bg-muted/60 text-[11.5px] text-muted-foreground" data-tr="ölçüm: 1 dakikalık external uptime probe · ay sonunda otomatik mahsup" data-en="measured by 1-minute external uptime probes · auto-applied end of month">ölçüm: 1 dakikalık external uptime probe · ay sonunda otomatik mahsup</div>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────── Process timeline ─────────────────── -->
<section class="py-20 border-b border-border">
  <div class="max-w-[1240px] mx-auto px-8 max-md:px-5">
    <div class="flex flex-col gap-4 max-w-[720px] mb-12">
      <span class="inline-flex items-center gap-2 font-mono text-[11px] text-muted-foreground uppercase tracking-[0.12em] whitespace-nowrap self-start"><span class="w-1.5 h-1.5 bg-primary rounded-full"></span><span data-tr="süreç" data-en="process">süreç</span></span>
      <h2 class="text-[clamp(24px,3vw,32px)] font-semibold -tracking-[0.022em] leading-[1.15]" data-tr="İlk görüşmeden production'a — 14 gün." data-en="From first call to production — 14 days.">İlk görüşmeden production'a — 14 gün.</h2>
    </div>
    <div class="grid grid-cols-4 max-[920px]:grid-cols-2 max-[560px]:grid-cols-1 gap-3.5">
      <div class="border border-border rounded-3xl bg-card p-6 flex flex-col gap-2.5">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-full bg-primary text-primary-foreground grid place-items-center font-mono text-[12px] font-semibold">01</span>
          <span class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider" data-tr="gün 0 — 1" data-en="day 0 – 1">gün 0 — 1</span>
        </div>
        <h3 class="text-[15.5px] font-semibold -tracking-[0.015em]" data-tr="Discovery call" data-en="Discovery call">Discovery call</h3>
        <p class="text-[12.5px] text-muted-foreground leading-snug" data-tr="30dk Zoom: kullanım senaryosu, request hacmi, veri yerelliği, uyum gereksinimleri. Önceki vendor'dan göç olup olmayacağını anlıyoruz." data-en="30-min Zoom: use case, traffic volume, residency, compliance. We check whether you're migrating from another vendor.">30dk Zoom: kullanım senaryosu, request hacmi, veri yerelliği, uyum gereksinimleri. Önceki vendor'dan göç olup olmayacağını anlıyoruz.</p>
      </div>
