---
<Base title="Backlex — the AI-native backend you code and deploy globally">
  <div style="color:#ECEAF7;font-family:'Manrope',sans-serif;">

    <!-- ═════════════════ HERO ═════════════════ -->
    <header id="top" style="position:relative;z-index:1;max-width:1180px;margin:0 auto;padding:72px 24px 40px;">
      <!-- Below 900px the hero stacks: the Saturn art leaves the flow and sits
           behind the CTA row as ambient background instead of dangling under it. -->
      <div class="flex flex-wrap items-center gap-12 max-[900px]:relative">
        <div class="flex-[1_1_520px] min-w-[320px] max-[900px]:relative max-[900px]:z-[1] max-[900px]:min-w-0">
          <h1 style="font-family:'Lexend',sans-serif;font-weight:300;font-size:clamp(34px,5vw,62px);line-height:1.05;letter-spacing:-0.03em;margin:0 0 24px;color:#F6F4FE;text-wrap:balance;">
            Code your backend with AI.
            <span class="cosmos-grad" style="display:block;line-height:1.16;padding-bottom:0.1em;">Deploy it globally.</span>
          </h1>
          <p style="font-size:19px;line-height:1.6;color:#ADA8C8;max-width:560px;margin:0 0 34px;">
            <strong style="color:#F0EEFA;font-weight:600;">Describe it in plain language and let AI build it — or write it yourself.</strong> Either way you ship a production-grade backend, deployed to the edge worldwide. Built for professional developers and vibe coders alike.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;margin-bottom:30px;">
            <a href="https://cloud.backlex.com/sign-up" class="c-btn-p" style={btnPrimary + "padding:13px 24px;font-size:15px;animation:cosmos-glow-pulse 4s ease-in-out infinite;"}>Start free on Cloud →</a>
            <a href="https://play.backlex.com" class="c-btn-g" style={btnGhost + "padding:13px 24px;font-size:15px;"}>Try the live playground →</a>
          </div>
        </div>

        <!-- Saturn / orbit hero graphic -->
        <div class="flex flex-[1_1_380px] min-w-[300px] justify-center max-[900px]:pointer-events-none max-[900px]:absolute max-[900px]:inset-x-0 max-[900px]:bottom-[-108px] max-[900px]:z-0 max-[900px]:h-[440px] max-[900px]:min-w-0 max-[900px]:items-center max-[900px]:opacity-70">
          <div style="position:relative;width:440px;height:440px;max-width:90vw;">
            <div style="position:absolute;inset:0;">
              <!-- back halves of the tilted orbit rings -->
              <div style="position:absolute;left:50%;top:50%;width:260px;height:156px;margin:-78px 0 0 -130px;transform:rotate(-22deg);clip-path:inset(0 0 50% 0);"><div style="position:absolute;inset:0;border-radius:50%;border:1.5px solid rgba(255,255,255,0.14);"></div></div>
              <div style="position:absolute;left:50%;top:50%;width:330px;height:198px;margin:-99px 0 0 -165px;transform:rotate(-22deg);clip-path:inset(0 0 50% 0);"><div style="position:absolute;inset:0;border-radius:50%;border:3.5px solid rgba(255,157,131,0.42);"></div></div>
              <div style="position:absolute;left:50%;top:50%;width:400px;height:240px;margin:-120px 0 0 -200px;transform:rotate(-22deg);clip-path:inset(0 0 50% 0);"><div style="position:absolute;inset:0;border-radius:50%;border:1.5px solid rgba(185,163,255,0.16);"></div></div>

              <!-- back-half orbiting data dots -->
              <div style="position:absolute;left:50%;top:50%;width:260px;height:156px;margin:-78px 0 0 -130px;transform:rotate(-22deg);clip-path:inset(0 0 50% 0);">
                <span class="c-orbit-dot" style="position:absolute;top:0;left:0;width:6px;height:6px;border-radius:50%;background:#d6fff2;box-shadow:0 0 10px 2px rgba(124,230,192,0.95);offset-path:path('M 0,78 a 130,78 0 1,0 260,0 a 130,78 0 1,0 -260,0');animation:cosmos-orbit-flow 5.5s linear infinite,cosmos-data-pulse 1.1s ease-in-out infinite;"></span>
              </div>
              <div style="position:absolute;left:50%;top:50%;width:330px;height:198px;margin:-99px 0 0 -165px;transform:rotate(-22deg);clip-path:inset(0 0 50% 0);">
                <span class="c-orbit-dot" style="position:absolute;top:0;left:0;width:7px;height:7px;border-radius:50%;background:#fff2ea;box-shadow:0 0 11px 2px rgba(255,157,131,0.95);offset-path:path('M 0,99 a 165,99 0 1,0 330,0 a 165,99 0 1,0 -330,0');animation:cosmos-orbit-flow 7s linear infinite,cosmos-data-pulse 1.2s ease-in-out infinite;"></span>
                <span class="c-orbit-dot" style="position:absolute;top:0;left:0;width:7px;height:7px;border-radius:50%;background:#fff2ea;box-shadow:0 0 11px 2px rgba(255,157,131,0.95);offset-path:path('M 0,99 a 165,99 0 1,0 330,0 a 165,99 0 1,0 -330,0');animation:cosmos-orbit-flow 7s linear infinite -3.5s,cosmos-data-pulse 1.2s ease-in-out infinite;"></span>
              </div>
              <div style="position:absolute;left:50%;top:50%;width:400px;height:240px;margin:-120px 0 0 -200px;transform:rotate(-22deg);clip-path:inset(0 0 50% 0);">
                <span class="c-orbit-dot" style="position:absolute;top:0;left:0;width:6px;height:6px;border-radius:50%;background:#e7deff;box-shadow:0 0 10px 2px rgba(185,163,255,0.9);offset-path:path('M 0,120 a 200,120 0 1,0 400,0 a 200,120 0 1,0 -400,0');animation:cosmos-orbit-flow 9.5s linear infinite,cosmos-data-pulse 1.4s ease-in-out infinite;"></span>
              </div>

              <!-- planet -->
