      </div>
    </div>

    <!-- Connect once, then drive it from your editor -->
    <div class="mt-3.5 grid grid-cols-2 max-[1020px]:grid-cols-1 gap-3.5">
      <!-- 1 · Connect (real command) -->
      <div class="border border-border rounded-3xl bg-card overflow-hidden flex flex-col">
        <div class="px-5 pt-4 pb-3 flex items-center gap-2 border-b border-border">
