  { title: "Backups with real PITR", desc: "Daily automatic snapshots plus on-demand ones, and point-in-time restore through D1 Time Travel — 7 days on Pro, 30 on Scale and Max.", tag: "daily · on-demand · time travel" },
  { title: "Custom domain + edge SSL", desc: "Point a subdomain or a root domain at your project. Certificates are issued and rotated for you through Cloudflare for SaaS. Pro and up.", tag: "api.acme.app · automatic ssl" },
  { title: "Preview branches", desc: "A branch or PR gets a full isolated instance — its own database, bucket, and URL — with data cloned from the parent and torn down for real when it closes.", tag: "isolated instance · auto teardown" },
  { title: "Keys you don't have to own", desc: "AI embeddings and generation, transactional email, push, and SMS run through managed gateways. Metered against your plan and hard-capped, so nothing runs away.", tag: "ai · email · push · sms" },
  { title: "Meters, alarms, audit", desc: "Requests, database and object storage against your plan caps, a 30-day chart, and CSV export. Set an alarm at any percentage and it fires to email, Slack, or a webhook.", tag: "alarms · csv export · audit log" },
  { title: "Upgrades roll forward", desc: "Your instance is upgraded in place as new versions ship — or take it yourself from Settings with one click. No redeploy, no downtime window to book.", tag: "in-place · one click" },
