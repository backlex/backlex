<span class="c-comment"># filter via the permissions DSL</span>
<span class="c-prompt">$ </span><span class="c-fn">curl</span> <span class="c-str">"http://localhost:5173/api/items/posts?filter=$(echo \
       '<span class="c-key">&#123;</span><span class="c-str">"status"</span>:<span class="c-key">&#123;</span><span class="c-str">"_eq"</span>:<span class="c-str">"published"</span><span class="c-key">&#125;</span>,<span class="c-str">"views"</span>:<span class="c-key">&#123;</span><span class="c-str">"_gt"</span>:<span class="c-num">100</span><span class="c-key">&#125;&#125;</span>' | jq -sRr @uri)&amp;sort=-views"</span>

<span class="c-comment"># or graphql</span>
<span class="c-prompt">$ </span><span class="c-fn">curl</span> -X <span class="c-key">POST</span> http://localhost:5173/api/graphql \
