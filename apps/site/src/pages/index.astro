<script is:inline>
  // Quickstart tab switcher
  document.querySelectorAll(".code-block").forEach((block) => {
    const tabs = [...block.querySelectorAll(".tab")];
    const panes = [...block.querySelectorAll("pre")];
    function activate(pane) {
      tabs.forEach((t) => {
        const on = t.dataset.pane === pane;
        t.classList.toggle("text-foreground", on);
        t.classList.toggle("!border-primary", on);
        t.classList.toggle("text-muted-foreground", !on);
      });
      panes.forEach((p) => {
        p.hidden = p.id !== "pane-" + pane;
      });
    }
    tabs.forEach((t) => t.addEventListener("click", () => activate(t.dataset.pane)));
    activate("shell");
  });

  // Mobile accordion: .acc cards ship open (graceful no-JS = expanded). Under
  // 640px collapse all but the first in each group (so every section opens with
  // a hint of content), and keep it exclusive — opening one closes its
  // siblings. Re-syncs on breakpoint change.
  (function () {
    const mq = window.matchMedia("(max-width: 639px)");
    const items = [...document.querySelectorAll("details.acc")];
    function sync() {
      const mobile = mq.matches;
      const groupSeen = new Set();
      items.forEach((d) => {
        const group = d.parentElement;
        const isFirst = group ? !groupSeen.has(group) : true;
        if (group) groupSeen.add(group);
        d.open = !mobile || isFirst;
      });
    }
    items.forEach((d) => {
      d.addEventListener("toggle", () => {
        if (!mq.matches || !d.open) return;
        const group = d.parentElement;
        if (!group) return;
        group.querySelectorAll(":scope > details.acc").forEach((o) => {
          if (o !== d) o.open = false;
        });
      });
    });
    sync();
    mq.addEventListener("change", sync);
  })();
</script>
