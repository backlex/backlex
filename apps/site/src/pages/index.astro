<span class="c-kw">const</span> <span class="c-fn">wks</span> = <span class="c-fn">createClient</span>(&#123; url: <span class="c-str">"http://localhost:5173"</span> &#125;);

<span class="c-kw">const</span> r = <span class="c-kw">await</span> wks.<span class="c-fn">from</span>&lt;Posts&gt;(<span class="c-str">"posts"</span>).<span class="c-fn">list</span>(&#123;
