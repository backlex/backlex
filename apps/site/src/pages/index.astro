            <span style="width:11px;height:11px;border-radius:50%;background:#ffbd2e;"></span>
            <span style="width:11px;height:11px;border-radius:50%;background:#28c840;"></span>
            <span style="margin-left:10px;font-family:'JetBrains Mono',monospace;font-size:11px;color:#7E789B;">terminal</span>
          </div>
          <pre id="cosmos-terminal" style="margin:0;padding:20px;font-family:'JetBrains Mono',monospace;font-size:12.5px;line-height:1.8;color:#C9C5DD;overflow-x:auto;min-height:300px;"></pre>
        </div>
      </div>
    </section>
    <script is:inline>
      (function () {
        function initTerminal() {
          var el = document.getElementById("cosmos-terminal");
          if (!el || el.dataset.init) return;
          el.dataset.init = "1";
          var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          var G = "#7CE6C0", TXT = "#E7E4F4", DIM = "#6E6A86", RES = "#C9C5DD", VIO = "#b9a3ff";
          var cur =
            '<span style="display:inline-block;width:8px;height:1.05em;vertical-align:-2px;background:' +
            G + ';margin-left:2px;animation:cosmos-blink 1s step-end infinite;"></span>';
          function esc(s) { return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }
          var lines = [
            { k: "c", t: "# clone, install, run — one terminal" },
            { k: "$", t: "git clone github.com/backlex/backlex && cd backlex" },
            { k: "$", t: "bun install" },
            { k: "$", t: "cp apps/web/.dev.vars.example apps/web/.dev.vars" },
            { k: "b" },
            { k: "c", t: "# migrate local sqlite, then start vite + miniflare" },
            { k: "$", t: "bun run db:migrate:sqlite" },
            { k: "$", t: "bun run dev" },
            { k: "b" },
            { k: "r", t: "ready in 2.3s on http://localhost:5173" },
            { k: "r", t: "sign up the first user at /sign-up" },
            { k: "ra" },
          ];
          function lineHtml(l, typedLen) {
            if (l.k === "b") return "";
            if (l.k === "c") return '<span style="color:' + DIM + ';">' + esc(l.t) + "</span>";
            if (l.k === "$") {
              var shown = typedLen == null ? l.t : l.t.slice(0, typedLen);
              return '<span style="color:' + G + ';">$ </span><span style="color:' + TXT + ';">' + esc(shown) + "</span>";
            }
            if (l.k === "r") return '<span style="color:' + G + ';">  ▸ </span><span style="color:' + RES + ';">' + esc(l.t) + "</span>";
            if (l.k === "ra") return '<span style="color:' + G + ';">  ▸ </span><span style="color:' + RES + ';">first user auto-gets the </span><span style="color:' + VIO + ';">admin</span><span style="color:' + RES + ';"> role</span>';
            return "";
          }
          if (reduce) {
            el.innerHTML = lines.map(function (l) { return lineHtml(l, null); }).join("\n") + '\n<span style="color:' + G + ';">$ </span>' + cur;
            return;
          }
          var done = [], li = 0, timer;
          function render(inProgress) {
            var parts = done.slice();
            if (inProgress != null) parts.push(inProgress);
            el.innerHTML = parts.join("\n") + cur;
          }
          function nextLine() {
            if (li >= lines.length) {
              done.push('<span style="color:' + G + ';">$ </span>');
              render(null);
              timer = setTimeout(function () { done = []; li = 0; typeLine(); }, 2600);
              return;
            }
            typeLine();
          }
          function typeLine() {
            var l = lines[li];
            if (l.k === "$") {
              var i = 0;
              (function tick() {
                render(lineHtml(l, i));
                if (i < l.t.length) { i++; timer = setTimeout(tick, 16 + Math.random() * 26); }
                else { done.push(lineHtml(l, null)); li++; timer = setTimeout(nextLine, 260); }
              })();
            } else {
              done.push(lineHtml(l, null));
              render(null);
              li++;
              timer = setTimeout(nextLine, l.k === "b" ? 80 : 160);
            }
          }
          typeLine();
        }
        document.addEventListener("astro:page-load", initTerminal);
        initTerminal();
      })();
    </script>

