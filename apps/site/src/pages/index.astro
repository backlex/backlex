const features = [
  { title: "Dynamic schema", desc: "Define collections in the admin, each becomes a physical c_<slug> table. CREATE TABLE runs against your live DB, no redeploy.", tag: "drizzle · pg + sqlite/d1" },
  { title: "Adopt or import a database", desc: "Wrap tables you already have with a metadata row — no DDL, no data migration. Or import from Postgres, MySQL, SQLite, MongoDB, Firestore and DynamoDB: plan it, run it, resume it, re-sync deltas.", tag: "adopt · 6 sources · --since" },
  { title: "Schema versions & branching", desc: "Snapshot the schema, diff two points in time, branch a change and apply it when it's ready. Auto-snapshots run on a schedule, so there is always a point to roll back to.", tag: "snapshot · diff · branch" },
  { title: "Permissions DSL", desc: "JSON predicates that compile to Drizzle SQL fragments and match in-process for realtime. Same syntax in roles, REST ?filter, and GraphQL.", tag: "$user.id · _eq · _in · $or" },
  { title: "REST + GraphQL", desc: "Every collection auto-exposes /api/items/:slug with filter/sort/expand/projection. GraphQL synthesised from the same metadata. Bulk + atomic writes on both.", tag: "openapi 3.1 · graphql-yoga" },
  { title: "Realtime", desc: "SSE in Bun, Durable Object + WebSocket on Workers. Per-event permission filter means subscribers see only what their role can read, and live queries push membership changes — not just raw row events.", tag: "sse · live queries · durable objects" },
  { title: "Edge functions", desc: "JavaScript sandbox with a host bridge for ctx.db / fetch / email. Bun worker thread, QuickJS-WASM, or remote HTTP — auto-selected per runtime.", tag: "quickjs · bun worker · http" },
  { title: "Storage + image transforms", desc: "Local FS in dev, R2 / S3 on edge. Image resize via Bun.Image, CF Image Resizing, or passthrough — same URL shape.", tag: "r2 · s3 · fs" },
  { title: "Webhooks & Flows", desc: "HMAC-signed outbound webhooks per event, plus a visual flow builder for branching multi-step automations. Fire-and-forget — never blocks API responses.", tag: "items.* · auth.* · cron" },
  { title: "Form builder", desc: "Drag blocks into a multi-step public form, then share the link or embed the script. Anonymous uploads get signed tickets, conditions and translations are built in, and submissions land in a collection.", tag: "blocks · steps · embed · /f/:token" },
  { title: "Extensions", desc: "Install admin panels, field editors, and hooks from npm or an upload. Hooks run sandboxed — on events or on the cron tick — so you extend the admin instead of forking it.", tag: "npm · upload · sandboxed hooks" },
  { title: "AI Agents", desc: "Agents that reason over your data and call your tools in a persisted reason→act loop. Every tool call runs through your permissions DSL; optional per-thread vector memory.", tag: "threads · tools · memory" },
  { title: "Auth, not yours to maintain", desc: "better-auth wrapper: email, OAuth, magic link, OTP, passkey, 2FA, SAML 2.0 SSO, LDAP / AD. Per-IP rate-limiting + account lockout built in.", tag: "better-auth · 2fa" },
  { title: "Activity + revisions", desc: "One activity table, dot-namespaced actions (item.update, auth.login). Every CRUD writes a row to revisions — point-in-time restore included.", tag: "audit log · point-in-time" },
  { title: "Traces, usage & advisor", desc: "W3C traceparent spans you can open in the admin or ship over OTLP, a per-key usage ledger with limits, and a linter that scores your schema, permissions, and config with a deep link to each fix.", tag: "otlp · usage ledger · lint score" },
  { title: "Insights & embedded BI", desc: "Build dashboards over your collections — six chart types, grouping, drill-through — and embed any of them in your own product behind a public iframe token.", tag: "panels · charts · /embed/d/:token" },
  { title: "Unified messaging", desc: "Push (FCM, APNs, Web Push) and SMS (Twilio, Amazon SNS) from one API. Per-tenant credentials, device + phone registries, and templates — all built in.", tag: "fcm · apns · web-push · sms" },
  { title: "Durable job queue", desc: "Background work that retries with exponential backoff, dead-letters after N tries, and runs on a schedule. Rides the cron tick — no Redis, no extra binding.", tag: "retry · dead-letter · runAt" },
  { title: "Resumable uploads", desc: "TUS 1.0.0 chunked uploads survive dropped connections and resume from the committed offset. Native R2 / S3 multipart under the hood.", tag: "tus 1.0.0 · multipart" },
  { title: "Draft & publish", desc: "First-class draft / published status: drafts hidden from readers without a publish permission, and scheduled publishing the cron tick applies when due.", tag: "_status · publishAt" },
  { title: "Feature flags", desc: "Toggle features and ship remote config without a deploy. Per-workspace or global, with rollout-percentage and permission-DSL targeting, evaluated per caller.", tag: "rollout % · targeting" },
  { title: "Offline-first sync", desc: "Keep a local copy that works offline: an incremental changefeed with delete tombstones, SSE live updates, and an offline write queue that flushes on reconnect.", tag: "changefeed · indexeddb · lww" },
  { title: "Edit like a spreadsheet", desc: "Grid mode with cell selection, keyboard nav, copy/paste, fill-down and undo — or a Kanban board grouped by status. Same permissions and validation as the item form.", tag: "grid · kanban · inline edit" },
  { title: "Two editors, no lost writes", desc: "Presence and field-level awareness on the item form and the rows table show who is editing what, and every PATCH carries an optimistic-concurrency guard that refuses a stale overwrite.", tag: "presence · awareness · conflict guard" },
  { title: "Content i18n", desc: "Localize any field — text, files, even relations — through a translations sidecar. Edit locales side by side, compare them, and let AI fill in the keys you haven't written yet.", tag: "locale bar · compare · auto-translate" },
];
