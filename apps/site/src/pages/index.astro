---
import Base from "../layouts/Base.astro";
---
<Base title="backlex — the AI-native backend you code and deploy globally">

<!-- ─────────────────── Hero ─────────────────── -->
<section class="relative z-[1] pt-24 max-sm:pt-10 pb-16 border-b border-border overflow-hidden"
  style="background: radial-gradient(60% 80% at 50% 0%, var(--color-tint), transparent 70%);">
  <div class="grid-mask"></div>
  <div class="relative max-w-[1240px] mx-auto px-8 max-md:px-5 flex flex-col items-center text-center gap-6 max-sm:gap-4">

    <span class="inline-block max-w-full text-center font-mono text-[11px] leading-relaxed text-muted-foreground uppercase tracking-[0.12em] border border-border rounded-full px-3 py-1.5 bg-muted">
      <span class="inline-block align-middle w-1.5 h-1.5 bg-primary rounded-full mr-2.5"></span>AI-native<span class="mx-2 text-border">·</span>MCP<span class="mx-2 text-border">·</span>Apache-2.0<span class="mx-2 text-border">·</span>Self-host<span class="mx-2 text-border">·</span>Workers<span class="mx-2 text-border">·</span>Vercel<span class="mx-2 text-border">·</span>Netlify<span class="mx-2 text-border">·</span>Deno
    </span>

    <h1 class="font-semibold -tracking-[0.04em] leading-[1.02] text-[clamp(40px,6vw,72px)] max-w-[18ch]">
      Code your backend <span class="text-primary dark:text-[oklch(0.82_0.22_131)]">with AI</span>.<br/>Deploy it globally.
    </h1>

    <p class="text-[19px] max-sm:text-[15px] text-muted-foreground max-w-[58ch] leading-snug">
      <strong class="text-foreground font-semibold">Describe it in plain language and let AI build it — or write it yourself.</strong> Either way you ship a production-grade backend, deployed to the edge worldwide. Built for professional developers and vibe coders alike.
    </p>

    <div class="flex gap-2.5 flex-wrap justify-center mt-2">
      <a href="/docs" class="inline-flex items-center gap-2 h-11 px-5 rounded-4xl bg-primary text-primary-foreground text-[14.5px] font-medium no-underline shadow-[0_1px_0_color-mix(in_oklch,var(--color-primary)_40%,oklch(0.3_0.1_131))] hover:bg-[color-mix(in_oklch,var(--color-primary)_90%,var(--color-foreground))] transition-colors whitespace-nowrap">Read the docs →</a>
      <a href="https://cloud.backlex.com/sign-up" class="inline-flex items-center gap-2 h-11 px-5 rounded-4xl border border-border bg-background text-foreground text-[14.5px] font-medium no-underline hover:bg-muted transition-colors whitespace-nowrap">Start free on Cloud →</a>
      <a href="#features" class="inline-flex items-center gap-2 h-11 px-5 rounded-4xl text-muted-foreground hover:text-foreground hover:bg-muted text-[14.5px] font-medium no-underline transition-colors whitespace-nowrap">See what's in it</a>
    </div>

    <div class="mt-6 grid grid-cols-4 max-md:grid-cols-2 gap-7 border-t border-b border-border py-5 max-w-[760px] w-full">
      <div class="flex flex-col items-center gap-0.5"><span class="font-mono text-lg font-medium">330+</span><span class="text-[11px] uppercase tracking-wider text-muted-foreground">edge cities</span></div>
      <div class="flex flex-col items-center gap-0.5"><span class="font-mono text-lg font-medium">~50ms</span><span class="text-[11px] uppercase tracking-wider text-muted-foreground">p95 anywhere</span></div>
      <div class="flex flex-col items-center gap-0.5"><span class="font-mono text-lg font-medium">8</span><span class="text-[11px] uppercase tracking-wider text-muted-foreground">deploy targets</span></div>
      <div class="flex flex-col items-center gap-0.5"><span class="font-mono text-lg font-medium">Apache 2.0</span><span class="text-[11px] uppercase tracking-wider text-muted-foreground">license</span></div>
    </div>

    <!-- Runtime + deploy compatibility (factual "runs on" — not endorsement) -->
    <div class="mt-12 w-full max-w-[840px] border border-border rounded-3xl bg-card/50 px-7 py-6 max-sm:px-4 max-sm:py-5 flex flex-col gap-4">
      <div class="flex items-center justify-center gap-x-6 gap-y-3 flex-wrap">
        <span class="font-mono text-[10.5px] text-muted-foreground uppercase tracking-[0.14em] mr-1 max-sm:basis-full max-sm:text-center">Runs on</span>
