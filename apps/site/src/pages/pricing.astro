---
import Base from "../layouts/Base.astro";
---
<Base title="backlex Cloud — pricing">

<!-- ─────────────────── Hero ─────────────────── -->
<section class="relative pt-20 pb-12 border-b border-border overflow-hidden"
  style="background: radial-gradient(60% 80% at 50% 0%, var(--color-tint), transparent 70%);">
  <div class="relative max-w-[1240px] mx-auto px-8 max-md:px-5 flex flex-col items-center text-center gap-5">
    <span class="inline-flex items-center gap-2 font-mono text-[11px] text-muted-foreground uppercase tracking-[0.12em] whitespace-nowrap border border-border rounded-full px-3 py-1.5 bg-muted">
      <span class="w-1.5 h-1.5 bg-primary rounded-full"></span>
      <span>transparent · cloudflare-powered</span>
    </span>
    <h1 class="font-semibold -tracking-[0.04em] leading-[1.04] text-[clamp(36px,5vw,56px)] max-w-[20ch]">From free to production, <span class='text-primary dark:text-[oklch(0.82_0.22_131)]'>limits and prices are transparent.</span></h1>
    <p class="text-[17px] text-muted-foreground max-w-[60ch] leading-snug">Each tier maps to real numbers from Cloudflare's vendor docs. We email near the limit; we don't surprise your card.</p>

    <!-- Billing toggle -->
    <div class="mt-3 inline-flex items-center rounded-full border border-border bg-card p-1 text-[12.5px] font-medium">
      <button id="billing-monthly" class="px-4 h-8 rounded-full bg-muted text-foreground">Monthly</button>
      <button id="billing-annual" class="px-4 h-8 rounded-full text-muted-foreground"><span>Annual</span> <span class="font-mono text-[10.5px] uppercase tracking-wider ml-1" style="color: oklch(0.42 0.16 131);">-20%</span></button>
    </div>
  </div>
</section>

<!-- ─────────────────── Pricing cards ─────────────────── -->
<section class="py-16 border-b border-border">
  <div class="max-w-[1240px] mx-auto px-8 max-md:px-5">
    <div class="grid grid-cols-4 max-[1020px]:grid-cols-2 max-[560px]:grid-cols-1 gap-3.5">

      <!-- Free -->
      <div class="border border-border rounded-3xl bg-card p-6 flex flex-col gap-4">
        <div>
          <div class="font-mono text-[11px] text-muted-foreground uppercase tracking-[0.12em] mb-2">Free</div>
          <div class="text-[36px] font-semibold -tracking-[0.022em] leading-none">$0</div>
          <p class="text-[12.5px] text-muted-foreground mt-2">Forever. No card.</p>
        </div>
        <a href="#" class="inline-flex items-center justify-center h-10 px-4 rounded-3xl border border-border bg-background hover:bg-muted text-foreground text-[13px] font-medium no-underline transition-colors">Sign up</a>
        <div class="pt-3 border-t border-border">
          <div class="text-[11px] uppercase tracking-wider font-medium text-muted-foreground mb-2">includes</div>
          <ul class="text-[12.5px] space-y-1.5 list-none p-0">
            <li class="flex gap-2"><span class="text-primary">✓</span><span>100K requests / mo</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>10ms CPU / req</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>500MB D1 · 1GB R2</li>
            <li class="flex gap-2"><span class="text-primary">✓</span><span>1 project · 1 env</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>backlex.com subdomain</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>50 realtime conn.</li>
            <li class="flex gap-2"><span class="text-muted-foreground">−</span><span class="text-muted-foreground">No backup / PITR</span></li>
            <li class="flex gap-2"><span class="text-muted-foreground">−</span><span class="text-muted-foreground">Community support</span></li>
          </ul>
        </div>
      </div>

      <!-- Pro -->
      <div class="border-2 rounded-3xl p-6 flex flex-col gap-4 relative" style="border-color: color-mix(in oklch, var(--color-primary) 55%, var(--color-border)); background: color-mix(in oklch, var(--color-primary) 5%, var(--color-card));">
        <span class="absolute -top-2.5 left-6 text-[10.5px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-full bg-primary text-primary-foreground">most teams</span>
        <div>
          <div class="font-mono text-[11px] uppercase tracking-[0.12em] mb-2" style="color: color-mix(in oklch, var(--color-primary) 60%, var(--color-foreground));">Pro</div>
          <div class="text-[36px] font-semibold -tracking-[0.022em] leading-none"><span data-price-monthly="19" data-price-annual="15">$19</span><span class="text-[14px] font-normal text-muted-foreground"> / <span>project / mo</span></span></div>
          <p class="text-[12.5px] text-muted-foreground mt-2">Production, small teams. 14-day free trial.</p>
        </div>
        <a href="#" class="inline-flex items-center justify-center h-10 px-4 rounded-3xl bg-primary text-primary-foreground hover:bg-[color-mix(in_oklch,var(--color-primary)_90%,var(--color-foreground))] text-[13px] font-medium no-underline transition-colors">Try 14 days free</a>
        <div class="pt-3 border-t border-border">
          <div class="text-[11px] uppercase tracking-wider font-medium text-muted-foreground mb-2">Free + </div>
          <ul class="text-[12.5px] space-y-1.5 list-none p-0">
            <li class="flex gap-2"><span class="text-primary">✓</span><span>10M requests / mo</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>30s CPU / req</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>5GB D1 · 25GB R2</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>3 <span>projects · unlimited envs</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>Custom domain</li>
            <li class="flex gap-2"><span class="text-primary">✓</span><span>Daily backup, 7-day PITR</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>Preview branches</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>Slack Connect destek</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>5K realtime conn.</li>
          </ul>
        </div>
      </div>

      <!-- Scale -->
      <div class="border border-border rounded-3xl bg-card p-6 flex flex-col gap-4">
        <div>
          <div class="font-mono text-[11px] text-muted-foreground uppercase tracking-[0.12em] mb-2">Scale</div>
          <div class="text-[36px] font-semibold -tracking-[0.022em] leading-none"><span data-price-monthly="99" data-price-annual="79">$99</span><span class="text-[14px] font-normal text-muted-foreground"> / <span>project / mo</span></span></div>
          <p class="text-[12.5px] text-muted-foreground mt-2">Traffic grew, SLA matters.</p>
        </div>
        <a href="#" class="inline-flex items-center justify-center h-10 px-4 rounded-3xl border border-border bg-background hover:bg-muted text-foreground text-[13px] font-medium no-underline transition-colors">Go Scale</a>
        <div class="pt-3 border-t border-border">
          <div class="text-[11px] uppercase tracking-wider font-medium text-muted-foreground mb-2">Pro + </div>
          <ul class="text-[12.5px] space-y-1.5 list-none p-0">
            <li class="flex gap-2"><span class="text-primary">✓</span><span>100M requests / mo</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>5min CPU / req</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>10GB D1 · 500GB R2</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>25 <span>projects</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span><span>11 regions, pinning</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>30 <span>day PITR</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>Neon Postgres add-on</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>50K realtime conn.</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>99.9% SLA</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>SAML SSO</li>
          </ul>
        </div>
      </div>

      <!-- Max -->
      <div class="border border-border rounded-3xl bg-card p-6 flex flex-col gap-4">
        <div>
          <div class="font-mono text-[11px] text-muted-foreground uppercase tracking-[0.12em] mb-2">Max</div>
          <div class="text-[36px] font-semibold -tracking-[0.022em] leading-none"><span data-price-monthly="199" data-price-annual="159">$199</span><span class="text-[14px] font-normal text-muted-foreground"> / <span>project / mo</span></span></div>
          <p class="text-[12.5px] text-muted-foreground mt-2">Highest tier — self-serve, no sales call.</p>
        </div>
        <a href="https://cloud.backlex.com" class="inline-flex items-center justify-center h-10 px-4 rounded-3xl border border-border bg-background hover:bg-muted text-foreground text-[13px] font-medium no-underline transition-colors">Go Max</a>
        <div class="pt-3 border-t border-border">
          <div class="text-[11px] uppercase tracking-wider font-medium text-muted-foreground mb-2">Scale + </div>
          <ul class="text-[12.5px] space-y-1.5 list-none p-0">
            <li class="flex gap-2"><span class="text-primary">✓</span><span>500M requests / mo</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>5min CPU / req</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>10GB D1 · 2TB R2</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>100 <span>projects</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span><span>90-day PITR</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>SCIM provisioning</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>200K realtime conn.</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>99.95% SLA</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>Priority phone support</li>
          </ul>
        </div>
      </div>
    </div>

    <p class="mt-6 text-[12.5px] text-muted-foreground text-center">All prices exclude VAT. TRY invoicing available for Turkey-based customers. 20% off annual plans. D1 is capped at 10&nbsp;GB per database — use the Neon Postgres add-on for larger datasets.</p>
  </div>
</section>

<!-- ─────────────────── Full comparison table ─────────────────── -->
<section class="py-20 border-b border-border bg-muted/40">
  <div class="max-w-[1240px] mx-auto px-8 max-md:px-5">
    <div class="flex flex-col gap-4 max-w-[720px] mb-10">
      <span class="inline-flex items-center gap-2 font-mono text-[11px] text-muted-foreground uppercase tracking-[0.12em] whitespace-nowrap self-start"><span class="w-1.5 h-1.5 bg-primary rounded-full"></span><span>full comparison</span></span>
      <h2 class="text-[clamp(24px,3vw,32px)] font-semibold -tracking-[0.022em] leading-[1.15]">Everything, line by line.</h2>
    </div>
    <div class="border border-border rounded-3xl bg-card overflow-x-auto">
      <table class="w-full border-collapse text-[13px] min-w-[820px]">
        <thead>
          <tr class="bg-muted">
            <th class="px-5 py-3.5 text-left font-medium text-xs uppercase tracking-wider text-muted-foreground border-b border-border sticky left-0 bg-muted">Feature</th>
            <th class="px-5 py-3.5 text-left font-medium text-xs uppercase tracking-wider text-muted-foreground border-b border-border">Free</th>
            <th class="px-5 py-3.5 text-left font-medium text-xs uppercase tracking-wider text-foreground border-b border-border">Pro</th>
            <th class="px-5 py-3.5 text-left font-medium text-xs uppercase tracking-wider text-muted-foreground border-b border-border">Scale</th>
            <th class="px-5 py-3.5 text-left font-medium text-xs uppercase tracking-wider text-muted-foreground border-b border-border">Max</th>
          </tr>
        </thead>
        <tbody>
          <!-- Capacity -->
          <tr class="bg-muted/50">
            <td colspan="5" class="px-5 py-2 text-[11px] uppercase tracking-wider font-mono text-muted-foreground">capacity</td>
          </tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">Monthly requests</td><td class="px-5 py-2.5 border-b border-border font-mono">100K</td><td class="px-5 py-2.5 border-b border-border font-mono">10M</td><td class="px-5 py-2.5 border-b border-border font-mono">100M</td><td class="px-5 py-2.5 border-b border-border font-mono">500M</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">CPU / request</td><td class="px-5 py-2.5 border-b border-border font-mono">10ms</td><td class="px-5 py-2.5 border-b border-border font-mono">30s</td><td class="px-5 py-2.5 border-b border-border font-mono">5min</td><td class="px-5 py-2.5 border-b border-border font-mono">5min</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">D1 size</td><td class="px-5 py-2.5 border-b border-border font-mono">500MB</td><td class="px-5 py-2.5 border-b border-border font-mono">5GB</td><td class="px-5 py-2.5 border-b border-border font-mono">10GB</td><td class="px-5 py-2.5 border-b border-border font-mono">10GB</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">R2 storage</td><td class="px-5 py-2.5 border-b border-border font-mono">1GB</td><td class="px-5 py-2.5 border-b border-border font-mono">25GB</td><td class="px-5 py-2.5 border-b border-border font-mono">500GB</td><td class="px-5 py-2.5 border-b border-border font-mono">2TB</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">Workers AI</td><td class="px-5 py-2.5 border-b border-border font-mono">5K neurons/day</td><td class="px-5 py-2.5 border-b border-border font-mono">200K/mo</td><td class="px-5 py-2.5 border-b border-border font-mono">2M/mo</td><td class="px-5 py-2.5 border-b border-border font-mono">10M/mo</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">Egress</td><td class="px-5 py-2.5 border-b border-border text-primary font-mono">∞</td><td class="px-5 py-2.5 border-b border-border text-primary font-mono">∞</td><td class="px-5 py-2.5 border-b border-border text-primary font-mono">∞</td><td class="px-5 py-2.5 border-b border-border text-primary font-mono">∞</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">Realtime conn.</td><td class="px-5 py-2.5 border-b border-border font-mono">50</td><td class="px-5 py-2.5 border-b border-border font-mono">5K</td><td class="px-5 py-2.5 border-b border-border font-mono">50K</td><td class="px-5 py-2.5 border-b border-border font-mono">200K</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">Projects</td><td class="px-5 py-2.5 border-b border-border font-mono">1</td><td class="px-5 py-2.5 border-b border-border font-mono">3</td><td class="px-5 py-2.5 border-b border-border font-mono">25</td><td class="px-5 py-2.5 border-b border-border font-mono">100</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">Team members</td><td class="px-5 py-2.5 border-b border-border font-mono">1</td><td class="px-5 py-2.5 border-b border-border font-mono">10</td><td class="px-5 py-2.5 border-b border-border font-mono">50</td><td class="px-5 py-2.5 border-b border-border font-mono">200</td></tr>

          <!-- Regions / runtime -->
          <tr class="bg-muted/50"><td colspan="5" class="px-5 py-2 text-[11px] uppercase tracking-wider font-mono text-muted-foreground">runtime · region</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">Edge regions</td><td class="px-5 py-2.5 border-b border-border font-mono">1</td><td class="px-5 py-2.5 border-b border-border font-mono">3</td><td class="px-5 py-2.5 border-b border-border font-mono">11</td><td class="px-5 py-2.5 border-b border-border font-mono">11</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">Region pinning</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">Custom domain</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">Preview branches</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td></tr>

          <!-- Backup -->
          <tr class="bg-muted/50"><td colspan="5" class="px-5 py-2 text-[11px] uppercase tracking-wider font-mono text-muted-foreground">backup · restore</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">Daily backup</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">PITR window</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border font-mono">7d</td><td class="px-5 py-2.5 border-b border-border font-mono">30d</td><td class="px-5 py-2.5 border-b border-border font-mono">90d</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">One-click export</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td></tr>

          <!-- Auth -->
          <tr class="bg-muted/50"><td colspan="5" class="px-5 py-2 text-[11px] uppercase tracking-wider font-mono text-muted-foreground">identity · security</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">Email / OAuth / Passkey</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">SAML SSO</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">SCIM provisioning</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">Audit log</td><td class="px-5 py-2.5 border-b border-border font-mono">7d</td><td class="px-5 py-2.5 border-b border-border font-mono">30d</td><td class="px-5 py-2.5 border-b border-border font-mono">90d</td><td class="px-5 py-2.5 border-b border-border font-mono">1y</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">IP allowlist</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td></tr>

          <!-- Support -->
          <tr class="bg-muted/50"><td colspan="5" class="px-5 py-2 text-[11px] uppercase tracking-wider font-mono text-muted-foreground">support · SLA</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">Support channel</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">community</td><td class="px-5 py-2.5 border-b border-border font-mono">slack</td><td class="px-5 py-2.5 border-b border-border font-mono">slack · email</td><td class="px-5 py-2.5 border-b border-border font-mono">slack · email · phone</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">First response SLA</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border font-mono">48sa</td><td class="px-5 py-2.5 border-b border-border font-mono">8sa</td><td class="px-5 py-2.5 border-b border-border font-mono">4sa</td></tr>
          <tr><td class="px-5 py-2.5 font-medium">Uptime SLA</td><td class="px-5 py-2.5 text-muted-foreground">none</td><td class="px-5 py-2.5 text-muted-foreground">none</td><td class="px-5 py-2.5 font-mono">99.9%</td><td class="px-5 py-2.5 font-mono">99.95%</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ─────────────────── Add-ons ─────────────────── -->
<section class="py-20 border-b border-border">
