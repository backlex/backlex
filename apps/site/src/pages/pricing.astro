---
import Base from "../layouts/Base.astro";
---
<Base title="backlex Cloud — pricing">

<!-- ═══════════════════════ Hero ═══════════════════════ -->
<section class="relative z-[1] pt-24 max-sm:pt-12 pb-14 border-b border-border overflow-hidden"
  style="background: radial-gradient(60% 80% at 50% 0%, var(--color-tint), transparent 70%);">
  <div class="relative max-w-[1240px] mx-auto px-8 max-md:px-5 flex flex-col items-center text-center gap-5">

    <span class="inline-flex items-center gap-2 font-mono text-[11px] text-muted-foreground uppercase tracking-[0.16em] whitespace-nowrap border border-border rounded-full px-3 py-1.5 bg-muted">
      <span class="w-1.5 h-1.5 rounded-full" style="background:#9b7bff"></span>
      <span>transparent · usage-based</span>
    </span>

    <h1 class="font-display font-light -tracking-[0.03em] leading-[1.04] text-[clamp(36px,5vw,58px)] max-w-[20ch]">
      From free to production, <span class="cosmos-grad">limits and prices are transparent.</span>
    </h1>

    <p class="text-[17px] max-sm:text-[15px] text-muted-foreground max-w-[60ch] leading-snug">
      Each tier maps to real infrastructure numbers. We email near the limit; we don't surprise your card.
    </p>

    <!-- Billing toggle -->
    <div class="bill-toggle mt-3" role="group" aria-label="Billing interval">
      <button type="button" data-billing="monthly" aria-pressed="true">Monthly</button>
      <button type="button" data-billing="annual" aria-pressed="false">
        <span>Annual</span>
        <span class="font-mono text-[10px] uppercase tracking-wider" style="color:#7CE6C0">-20%</span>
      </button>
    </div>
  </div>
</section>

<!-- ═══════════════════════ Plan cards ═══════════════════════ -->
<section class="relative z-[1] py-16 border-b border-border">
  <div class="max-w-[1240px] mx-auto px-8 max-md:px-5">
    <div class="grid grid-cols-4 max-[1020px]:grid-cols-2 max-[560px]:grid-cols-1 gap-3.5 items-start">

      <!-- Free -->
      <div class="glass glass-hover p-6 flex flex-col gap-4">
        <div>
          <div class="pr-plan">Free</div>
          <div class="pr-price">$0</div>
          <p class="pr-bill">Forever. No card.</p>
          <p class="pr-blurb">Spin up, ship, and stay free as long as you fit the limits.</p>
        </div>
        <a href="https://cloud.backlex.com/sign-up" class="pr-btn pr-btn-ghost">Sign up</a>
        <div class="pt-4 border-t border-border">
          <div class="pr-inc">includes</div>
          <ul class="pr-feat">
            <li><span class="mk-yes">✓</span><span>100K requests / mo</span></li>
            <li><span class="mk-yes">✓</span><span>5s CPU / req</span></li>
            <li><span class="mk-yes">✓</span><span>500MB DB · 1GB storage</span></li>
            <li><span class="mk-yes">✓</span><span>1 project · 3 workspaces</span></li>
            <li><span class="mk-yes">✓</span><span>backlex.com subdomain</span></li>
            <li><span class="mk-yes">✓</span><span>EU or Global residency</span></li>
            <li class="off"><span class="mk-no">−</span><span>No backup / PITR</span></li>
            <li class="off"><span class="mk-no">−</span><span>Community support</span></li>
          </ul>
        </div>
      </div>

      <!-- Pro (highlighted) -->
      <div class="pro-card p-6 flex flex-col gap-4">
        <span class="pro-badge">most teams</span>
        <div>
          <div class="pr-plan" style="color:#b9a3ff">Pro</div>
          <div class="pr-price"><span data-price-monthly="19" data-price-annual="15">$19</span><span class="pr-price-suf"> / project / mo</span></div>
          <p class="pr-bill" data-bill-monthly="billed monthly" data-bill-annual="billed annually · save 20%">billed monthly</p>
          <p class="pr-blurb">Production, small teams. 14-day free trial.</p>
        </div>
        <a href="https://cloud.backlex.com/sign-up?plan=pro" class="pr-btn pr-btn-grad">Try 14 days free</a>
        <div class="pt-4 border-t" style="border-color:rgba(139,108,255,0.22)">
          <div class="pr-inc">Free +</div>
          <ul class="pr-feat">
            <li><span class="mk-yes">✓</span><span>10M requests / mo</span></li>
            <li><span class="mk-yes">✓</span><span>30s CPU / req</span></li>
            <li><span class="mk-yes">✓</span><span>5GB DB · 25GB storage</span></li>
            <li><span class="mk-yes">✓</span><span>3 projects · 50 workspaces</span></li>
            <li><span class="mk-yes">✓</span><span>Custom domain</span></li>
            <li><span class="mk-yes">✓</span><span>Daily backup, 7-day PITR</span></li>
            <li><span class="mk-yes">✓</span><span>Preview branches</span></li>
            <li><span class="mk-yes">✓</span><span>Slack Connect support</span></li>
          </ul>
        </div>
      </div>

      <!-- Scale -->
      <div class="glass glass-hover p-6 flex flex-col gap-4">
        <div>
          <div class="pr-plan">Scale</div>
          <div class="pr-price"><span data-price-monthly="99" data-price-annual="79">$99</span><span class="pr-price-suf"> / project / mo</span></div>
          <p class="pr-bill" data-bill-monthly="billed monthly" data-bill-annual="billed annually · save 20%">billed monthly</p>
          <p class="pr-blurb">Traffic grew, SLA matters.</p>
        </div>
        <a href="https://cloud.backlex.com/sign-up?plan=scale" class="pr-btn pr-btn-ghost">Go Scale</a>
        <div class="pt-4 border-t border-border">
          <div class="pr-inc">Pro +</div>
          <ul class="pr-feat">
            <li><span class="mk-yes">✓</span><span>100M requests / mo</span></li>
            <li><span class="mk-yes">✓</span><span>5min CPU / req</span></li>
            <li><span class="mk-yes">✓</span><span>10GB DB · 500GB storage</span></li>
            <li><span class="mk-yes">✓</span><span>25 projects · 50 seats</span></li>
            <li><span class="mk-yes">✓</span><span>30 day PITR</span></li>
            <li><span class="mk-yes">✓</span><span>90-day audit log</span></li>
            <li><span class="mk-yes">✓</span><span>99.9% SLA</span></li>
            <li><span class="mk-yes">✓</span><span>SSO — OIDC + SAML 2.0</span></li>
          </ul>
        </div>
      </div>

      <!-- Max -->
      <div class="glass glass-hover p-6 flex flex-col gap-4">
        <div>
          <div class="pr-plan">Max</div>
          <div class="pr-price"><span data-price-monthly="199" data-price-annual="159">$199</span><span class="pr-price-suf"> / project / mo</span></div>
          <p class="pr-bill" data-bill-monthly="billed monthly" data-bill-annual="billed annually · save 20%">billed monthly</p>
          <p class="pr-blurb">Highest tier — self-serve, no sales call.</p>
        </div>
        <a href="https://cloud.backlex.com/sign-up?plan=max" class="pr-btn pr-btn-ghost">Go Max</a>
        <div class="pt-4 border-t border-border">
          <div class="pr-inc">Scale +</div>
          <ul class="pr-feat">
            <li><span class="mk-yes">✓</span><span>500M requests / mo</span></li>
            <li><span class="mk-yes">✓</span><span>10GB DB · 2TB storage</span></li>
            <li><span class="mk-yes">✓</span><span>100 projects · 200 seats</span></li>
            <li><span class="mk-yes">✓</span><span>1-year audit log</span></li>
            <li><span class="mk-yes">✓</span><span>99.95% SLA</span></li>
            <li><span class="mk-yes">✓</span><span>SCIM provisioning</span></li>
            <li><span class="mk-yes">✓</span><span>Priority support</span></li>
          </ul>
        </div>
      </div>
    </div>

    <p class="mt-6 text-[12.5px] text-muted-foreground text-center">All prices exclude VAT. 20% off annual plans. The managed database is capped at 10&nbsp;GB.</p>
  </div>
</section>

<!-- ═══════════════════════ Self-host strip ═══════════════════════ -->
<section class="relative z-[1] py-14 border-b border-border">
  <div class="max-w-[1240px] mx-auto px-8 max-md:px-5">
    <div class="glass p-8 max-sm:p-6 flex max-md:flex-col items-center max-md:items-start gap-7 justify-between">
      <div class="max-w-[64ch]">
        <h2 class="font-display text-[clamp(20px,2.4vw,28px)] font-semibold -tracking-[0.02em] leading-tight">Prefer to run it yourself? The open-source core is free, forever.</h2>
        <p class="text-[14px] text-muted-foreground mt-2 leading-snug">Same Apache-2.0 backlex — Bun, Node, Deno, Docker, or your own infrastructure. No seat fees, no quotas.</p>
      </div>
      <a href="https://github.com/backlex/backlex" class="pr-btn pr-btn-ghost h-11 px-5 text-[14px] flex-shrink-0">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.63-5.49 5.92.43.37.82 1.1.82 2.22 0 1.6-.02 2.9-.02 3.29 0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"/></svg>
        <span>GitHub ↗</span>
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════ Full comparison table ═══════════════════════ -->
<section class="relative z-[1] py-20 border-b border-border">
  <div class="max-w-[1240px] mx-auto px-8 max-md:px-5">
    <div class="flex flex-col gap-4 max-w-[720px] mb-10">
      <span class="pr-eyebrow"><span class="dot"></span>full comparison</span>
      <h2 class="font-display text-[clamp(24px,3vw,32px)] font-semibold -tracking-[0.022em] leading-[1.15]">Everything, line by line.</h2>
    </div>

    <div class="glass overflow-x-auto">
      <table class="w-full border-collapse text-[13px] min-w-[820px]">
        <thead>
          <tr>
            <th class="cmp-th text-left sticky left-0" style="min-width:220px">Feature</th>
            <th class="cmp-th">Free</th>
            <th class="cmp-th col-pro col-pro-top" style="color:#b9a3ff">Pro</th>
            <th class="cmp-th">Scale</th>
            <th class="cmp-th">Max</th>
          </tr>
        </thead>
        <tbody>
          <!-- capacity -->
          <tr class="cmp-grp"><td colspan="5"><span class="grp-h">capacity</span></td></tr>
          <tr><td class="cmp-f">Monthly requests</td><td class="cmp-v">100K</td><td class="cmp-v col-pro">10M</td><td class="cmp-v">100M</td><td class="cmp-v">500M</td></tr>
          <tr><td class="cmp-f">CPU / request</td><td class="cmp-v">5s</td><td class="cmp-v col-pro">30s</td><td class="cmp-v">5min</td><td class="cmp-v">5min</td></tr>
          <tr><td class="cmp-f">Database size</td><td class="cmp-v">500MB</td><td class="cmp-v col-pro">5GB</td><td class="cmp-v">10GB</td><td class="cmp-v">10GB</td></tr>
          <tr><td class="cmp-f">Object storage</td><td class="cmp-v">1GB</td><td class="cmp-v col-pro">25GB</td><td class="cmp-v">500GB</td><td class="cmp-v">2TB</td></tr>
          <tr><td class="cmp-f">Managed AI (neurons)</td><td class="cmp-v">5K/mo</td><td class="cmp-v col-pro">200K/mo</td><td class="cmp-v">2M/mo</td><td class="cmp-v">10M/mo</td></tr>
          <tr><td class="cmp-f">Egress</td><td class="cmp-v">∞</td><td class="cmp-v col-pro">∞</td><td class="cmp-v">∞</td><td class="cmp-v">∞</td></tr>
          <tr><td class="cmp-f">Realtime (WebSocket / SSE)</td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v col-pro"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td></tr>
          <tr><td class="cmp-f">Projects</td><td class="cmp-v">1</td><td class="cmp-v col-pro">3</td><td class="cmp-v">25</td><td class="cmp-v">100</td></tr>
          <tr><td class="cmp-f">Organizations</td><td class="cmp-v">1</td><td class="cmp-v col-pro">5</td><td class="cmp-v">10</td><td class="cmp-v">20</td></tr>
          <tr><td class="cmp-f">Workspaces / project</td><td class="cmp-v">3</td><td class="cmp-v col-pro">50</td><td class="cmp-v">250</td><td class="cmp-v">1,000</td></tr>
          <tr><td class="cmp-f">Team members</td><td class="cmp-v">1</td><td class="cmp-v col-pro">10</td><td class="cmp-v">50</td><td class="cmp-v">200</td></tr>

          <!-- runtime · region -->
          <tr class="cmp-grp"><td colspan="5"><span class="grp-h">runtime · region</span></td></tr>
          <tr><td class="cmp-f">Edge network</td><td class="cmp-v">Global</td><td class="cmp-v col-pro">Global</td><td class="cmp-v">Global</td><td class="cmp-v">Global</td></tr>
          <tr><td class="cmp-f">Data residency (EU / Global)</td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v col-pro"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td></tr>
          <tr><td class="cmp-f">Managed AI · email · push · SMS</td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v col-pro"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td></tr>
          <tr><td class="cmp-f">In-place instance upgrades</td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v col-pro"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td></tr>
          <tr><td class="cmp-f">Custom domain</td><td class="cmp-v"><span class="mk-no">—</span></td><td class="cmp-v col-pro"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td></tr>
          <tr><td class="cmp-f">Preview branches</td><td class="cmp-v"><span class="mk-no">—</span></td><td class="cmp-v col-pro"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td></tr>

          <!-- backup · restore -->
          <tr class="cmp-grp"><td colspan="5"><span class="grp-h">backup · restore</span></td></tr>
          <tr><td class="cmp-f">Daily backup</td><td class="cmp-v"><span class="mk-no">—</span></td><td class="cmp-v col-pro"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td></tr>
          <tr><td class="cmp-f">PITR window</td><td class="cmp-v"><span class="mk-no">—</span></td><td class="cmp-v col-pro">7d</td><td class="cmp-v">30d</td><td class="cmp-v">30d</td></tr>
          <tr><td class="cmp-f">One-click export</td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v col-pro"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td></tr>

          <!-- identity · security -->
          <tr class="cmp-grp"><td colspan="5"><span class="grp-h">identity · security</span></td></tr>
          <tr><td class="cmp-f">Email / OAuth / Passkey</td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v col-pro"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td></tr>
          <tr><td class="cmp-f">Enterprise SSO (OIDC + SAML)</td><td class="cmp-v"><span class="mk-no">—</span></td><td class="cmp-v col-pro"><span class="mk-no">—</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td></tr>
          <tr><td class="cmp-f">SCIM provisioning</td><td class="cmp-v"><span class="mk-no">—</span></td><td class="cmp-v col-pro"><span class="mk-no">—</span></td><td class="cmp-v"><span class="mk-no">—</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td></tr>
          <tr><td class="cmp-f">Audit log</td><td class="cmp-v">7d</td><td class="cmp-v col-pro">30d</td><td class="cmp-v">90d</td><td class="cmp-v">1y</td></tr>
          <tr><td class="cmp-f">IP allowlist · 2FA · passkeys</td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v col-pro"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td><td class="cmp-v"><span class="mk-yes">✓</span></td></tr>

          <!-- support · SLA -->
          <tr class="cmp-grp"><td colspan="5"><span class="grp-h">support · SLA</span></td></tr>
          <tr><td class="cmp-f">Support channel</td><td class="cmp-v">community</td><td class="cmp-v col-pro">slack</td><td class="cmp-v">slack · email</td><td class="cmp-v">slack · email · priority</td></tr>
          <tr><td class="cmp-f">First response SLA</td><td class="cmp-v"><span class="mk-no">—</span></td><td class="cmp-v col-pro">48h</td><td class="cmp-v">8h</td><td class="cmp-v">4h</td></tr>
          <tr><td class="cmp-f cmp-last">Uptime SLA</td><td class="cmp-v cmp-last">none</td><td class="cmp-v col-pro col-pro-bot cmp-last">none</td><td class="cmp-v cmp-last">99.9%</td><td class="cmp-v cmp-last">99.95%</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ═══════════════════════ Add-ons ═══════════════════════ -->
<section class="relative z-[1] py-20 border-b border-border">
  <div class="max-w-[1240px] mx-auto px-8 max-md:px-5">
    <div class="flex flex-col gap-4 max-w-[720px] mb-10">
      <span class="pr-eyebrow"><span class="dot"></span>add-ons</span>
      <h2 class="font-display text-[clamp(24px,3vw,32px)] font-semibold -tracking-[0.022em] leading-[1.15]">Add capacity when you need it, not before.</h2>
    </div>
    <div class="grid grid-cols-4 max-[1100px]:grid-cols-2 max-[560px]:grid-cols-1 gap-3.5">

      <div class="glass glass-hover p-6">
        <div class="flex items-center gap-2.5 mb-3">
          <span class="addon-ic">+</span>
          <h3 class="text-[15.5px] font-semibold whitespace-nowrap">Request pack</h3>
          <span class="ml-auto cf-pill whitespace-nowrap">one-time</span>
        </div>
        <div class="addon-price">$2<span class="addon-suf"> / 1M requests</span></div>
        <p class="text-[12.5px] text-muted-foreground mt-2 leading-snug">Cover a spike without jumping a tier. Applies to the current billing month and expires with it — it never renews behind your back.</p>
        <ul class="pr-feat pr-feat-sm mt-3">
          <li><span class="mk-yes">✓</span><span>Buy any quantity</span></li>
          <li><span class="mk-yes">✓</span><span>This month only</span></li>
          <li><span class="mk-yes">✓</span><span>Alarm at any %</span></li>
        </ul>
      </div>

      <div class="glass glass-hover p-6">
        <div class="flex items-center gap-2.5 mb-3">
          <span class="addon-ic">+</span>
          <h3 class="text-[15.5px] font-semibold whitespace-nowrap">AI neurons</h3>
          <span class="ml-auto cf-pill whitespace-nowrap">one-time</span>
        </div>
        <div class="addon-price">$25<span class="addon-suf"> / 1M neurons</span></div>
        <p class="text-[12.5px] text-muted-foreground mt-2 leading-snug">One budget for every AI we run for you — embeddings, vector search, and generation. Metered and hard-capped at the gateway.</p>
        <ul class="pr-feat pr-feat-sm mt-3">
          <li><span class="mk-yes">✓</span><span>$0.025 / 1K neurons</span></li>
          <li><span class="mk-yes">✓</span><span>No key of your own</span></li>
          <li><span class="mk-yes">✓</span><span>Usage in dashboard</span></li>
        </ul>
      </div>

      <div class="glass glass-hover p-6">
        <div class="flex items-center gap-2.5 mb-3">
          <span class="addon-ic">R</span>
          <h3 class="text-[15.5px] font-semibold whitespace-nowrap">Storage block</h3>
          <span class="ml-auto cf-pill whitespace-nowrap">monthly</span>
        </div>
        <div class="addon-price">$2<span class="addon-suf"> / 10GB / mo</span></div>
        <p class="text-[12.5px] text-muted-foreground mt-2 leading-snug">Object storage past your tier quota. You occupy it every month, so it renews monthly until you remove it.</p>
        <ul class="pr-feat pr-feat-sm mt-3">
          <li><span class="mk-yes">✓</span><span>Zero egress cost</span></li>
          <li><span class="mk-yes">✓</span><span>Image transforms auto</span></li>
          <li><span class="mk-yes">✓</span><span>Cancel any time</span></li>
        </ul>
      </div>

      <div class="glass glass-hover p-6">
        <div class="flex items-center gap-2.5 mb-3">
          <span class="addon-ic">D</span>
          <h3 class="text-[15.5px] font-semibold whitespace-nowrap">Database block</h3>
          <span class="ml-auto cf-pill whitespace-nowrap">monthly</span>
        </div>
        <div class="addon-price">$2.50<span class="addon-suf"> / GB / mo</span></div>
        <p class="text-[12.5px] text-muted-foreground mt-2 leading-snug">Extend the managed database past your tier quota, in 1GB steps. Renews monthly while the data sits there.</p>
        <ul class="pr-feat pr-feat-sm mt-3">
          <li><span class="mk-yes">✓</span><span>1GB steps</span></li>
