---
import Base from "../layouts/Base.astro";
---
<Base title="workeros Cloud — pricing">

<!-- ─────────────────── Hero ─────────────────── -->
<section class="relative pt-20 pb-12 border-b border-border overflow-hidden"
  style="background: radial-gradient(60% 80% at 50% 0%, var(--color-tint), transparent 70%);">
  <div class="relative max-w-[1240px] mx-auto px-8 max-md:px-5 flex flex-col items-center text-center gap-5">
    <span class="inline-flex items-center gap-2 font-mono text-[11px] text-muted-foreground uppercase tracking-[0.12em] whitespace-nowrap border border-border rounded-full px-3 py-1.5 bg-muted">
      <span class="w-1.5 h-1.5 bg-primary rounded-full"></span>
      <span data-tr="şeffaf · cloudflare altyapısı" data-en="transparent · cloudflare-powered">şeffaf · cloudflare altyapısı</span>
    </span>
    <h1 class="font-semibold -tracking-[0.04em] leading-[1.04] text-[clamp(36px,5vw,56px)] max-w-[20ch]" data-tr="Free'den production'a, <span class='text-primary dark:text-[oklch(0.82_0.22_131)]'>limit ve fiyat şeffaf.</span>" data-en="From free to production, <span class='text-primary dark:text-[oklch(0.82_0.22_131)]'>limits and prices are transparent.</span>">Free'den production'a, <span class="text-primary dark:text-[oklch(0.82_0.22_131)]">limit ve fiyat şeffaf.</span></h1>
    <p class="text-[17px] text-muted-foreground max-w-[60ch] leading-snug" data-tr="Her plan, Cloudflare'in vendor sayfasındaki gerçek rakamlarla hizalanmış. Üst limite yaklaştığında mail atıyoruz; karta yansımıyor." data-en="Each tier maps to real numbers from Cloudflare's vendor docs. We email near the limit; we don't surprise your card.">Her plan, Cloudflare'in vendor sayfasındaki gerçek rakamlarla hizalanmış. Üst limite yaklaştığında mail atıyoruz; karta yansımıyor.</p>

    <!-- Billing toggle -->
    <div class="mt-3 inline-flex items-center rounded-full border border-border bg-card p-1 text-[12.5px] font-medium">
      <button id="billing-monthly" class="px-4 h-8 rounded-full bg-muted text-foreground" data-tr="Aylık" data-en="Monthly">Aylık</button>
      <button id="billing-annual" class="px-4 h-8 rounded-full text-muted-foreground"><span data-tr="Yıllık" data-en="Annual">Yıllık</span> <span class="font-mono text-[10.5px] uppercase tracking-wider ml-1" style="color: oklch(0.42 0.16 131);">-20%</span></button>
    </div>
  </div>
</section>

<!-- ─────────────────── Pricing cards ─────────────────── -->
<section class="py-16 border-b border-border">
  <div class="max-w-[1240px] mx-auto px-8 max-md:px-5">
    <div class="grid grid-cols-4 max-[1020px]:grid-cols-2 max-[560px]:grid-cols-1 gap-3.5">

      <!-- Free -->
      <div class="border border-border rounded-3xl bg-card p-6 flex flex-col gap-4">
        <div>
          <div class="font-mono text-[11px] text-muted-foreground uppercase tracking-[0.12em] mb-2">Free</div>
          <div class="text-[36px] font-semibold -tracking-[0.022em] leading-none">€0</div>
          <p class="text-[12.5px] text-muted-foreground mt-2" data-tr="Sonsuza. Kart istemiyoruz." data-en="Forever. No card.">Sonsuza. Kart istemiyoruz.</p>
        </div>
        <a href="#" class="inline-flex items-center justify-center h-10 px-4 rounded-3xl border border-border bg-background hover:bg-muted text-foreground text-[13px] font-medium no-underline transition-colors" data-tr="Hesap aç" data-en="Sign up">Hesap aç</a>
        <div class="pt-3 border-t border-border">
          <div class="text-[11px] uppercase tracking-wider font-medium text-muted-foreground mb-2" data-tr="içerir" data-en="includes">içerir</div>
          <ul class="text-[12.5px] space-y-1.5 list-none p-0">
            <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="100K request / ay" data-en="100K requests / mo">100K request / ay</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>10ms CPU / req</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>500MB D1 · 1GB R2</li>
            <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="1 proje · 1 ortam" data-en="1 project · 1 env">1 proje · 1 ortam</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>workeros.cloud subdomain</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>50 realtime conn.</li>
            <li class="flex gap-2"><span class="text-muted-foreground">−</span><span class="text-muted-foreground" data-tr="Backup / PITR yok" data-en="No backup / PITR">Backup / PITR yok</span></li>
            <li class="flex gap-2"><span class="text-muted-foreground">−</span><span class="text-muted-foreground" data-tr="Community destek" data-en="Community support">Community destek</span></li>
          </ul>
        </div>
      </div>

      <!-- Pro -->
      <div class="border-2 rounded-3xl p-6 flex flex-col gap-4 relative" style="border-color: color-mix(in oklch, var(--color-primary) 55%, var(--color-border)); background: color-mix(in oklch, var(--color-primary) 5%, var(--color-card));">
        <span class="absolute -top-2.5 left-6 text-[10.5px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-full bg-primary text-primary-foreground" data-tr="çoğu takım" data-en="most teams">çoğu takım</span>
        <div>
          <div class="font-mono text-[11px] uppercase tracking-[0.12em] mb-2" style="color: color-mix(in oklch, var(--color-primary) 60%, var(--color-foreground));">Pro</div>
          <div class="text-[36px] font-semibold -tracking-[0.022em] leading-none"><span data-price-monthly="19" data-price-annual="15">€19</span><span class="text-[14px] font-normal text-muted-foreground"> / <span data-tr="proje / ay" data-en="project / mo">proje / ay</span></span></div>
          <p class="text-[12.5px] text-muted-foreground mt-2" data-tr="Production, küçük takım. 14 gün ücretsiz dene." data-en="Production, small teams. 14-day free trial.">Production, küçük takım. 14 gün ücretsiz dene.</p>
        </div>
        <a href="#" class="inline-flex items-center justify-center h-10 px-4 rounded-3xl bg-primary text-primary-foreground hover:bg-[color-mix(in_oklch,var(--color-primary)_90%,var(--color-foreground))] text-[13px] font-medium no-underline transition-colors" data-tr="14 gün ücretsiz dene" data-en="Try 14 days free">14 gün ücretsiz dene</a>
        <div class="pt-3 border-t border-border">
          <div class="text-[11px] uppercase tracking-wider font-medium text-muted-foreground mb-2" data-tr="Free + " data-en="Free + ">Free + </div>
          <ul class="text-[12.5px] space-y-1.5 list-none p-0">
            <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="10M request / ay" data-en="10M requests / mo">10M request / ay</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>30s CPU / req</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>5GB D1 · 25GB R2</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>3 <span data-tr="proje · sınırsız ortam" data-en="projects · unlimited envs">proje · sınırsız ortam</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>Custom domain</li>
            <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="Günlük backup, 7 gün PITR" data-en="Daily backup, 7-day PITR">Günlük backup, 7 gün PITR</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>Preview branches</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>Slack Connect destek</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>5K realtime conn.</li>
          </ul>
        </div>
      </div>

      <!-- Scale -->
      <div class="border border-border rounded-3xl bg-card p-6 flex flex-col gap-4">
        <div>
          <div class="font-mono text-[11px] text-muted-foreground uppercase tracking-[0.12em] mb-2">Scale</div>
          <div class="text-[36px] font-semibold -tracking-[0.022em] leading-none"><span data-price-monthly="99" data-price-annual="79">€99</span><span class="text-[14px] font-normal text-muted-foreground"> / <span data-tr="proje / ay" data-en="project / mo">proje / ay</span></span></div>
          <p class="text-[12.5px] text-muted-foreground mt-2" data-tr="Trafik büyüdü, SLA gerekli." data-en="Traffic grew, SLA matters.">Trafik büyüdü, SLA gerekli.</p>
        </div>
        <a href="#" class="inline-flex items-center justify-center h-10 px-4 rounded-3xl border border-border bg-background hover:bg-muted text-foreground text-[13px] font-medium no-underline transition-colors" data-tr="Scale planına geç" data-en="Go Scale">Scale planına geç</a>
        <div class="pt-3 border-t border-border">
          <div class="text-[11px] uppercase tracking-wider font-medium text-muted-foreground mb-2" data-tr="Pro + " data-en="Pro + ">Pro + </div>
          <ul class="text-[12.5px] space-y-1.5 list-none p-0">
            <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="100M request / ay" data-en="100M requests / mo">100M request / ay</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>5min CPU / req</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>50GB D1 · 500GB R2</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>25 <span data-tr="proje" data-en="projects">proje</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="11 region, pin opsiyonu" data-en="11 regions, pinning">11 region, pin opsiyonu</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>30 <span data-tr="gün PITR" data-en="day PITR">gün PITR</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>Neon Postgres add-on</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>50K realtime conn.</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>99.9% SLA</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>SAML SSO</li>
          </ul>
        </div>
      </div>

      <!-- Enterprise -->
      <div class="border border-border rounded-3xl bg-card p-6 flex flex-col gap-4">
        <div>
          <div class="font-mono text-[11px] text-muted-foreground uppercase tracking-[0.12em] mb-2">Enterprise</div>
          <div class="text-[26px] font-semibold -tracking-[0.022em] leading-tight" data-tr="Konuşalım" data-en="Let's talk">Konuşalım</div>
          <p class="text-[12.5px] text-muted-foreground mt-2" data-tr="Vendor review, MSA, dedicated cluster." data-en="Vendor review, MSA, dedicated cluster.">Vendor review, MSA, dedicated cluster.</p>
        </div>
        <a href="/enterprise" class="inline-flex items-center justify-center h-10 px-4 rounded-3xl border border-border bg-background hover:bg-muted text-foreground text-[13px] font-medium no-underline transition-colors" data-tr="Görüşme planla →" data-en="Book a call →">Görüşme planla →</a>
        <div class="pt-3 border-t border-border">
          <div class="text-[11px] uppercase tracking-wider font-medium text-muted-foreground mb-2" data-tr="Scale + " data-en="Scale + ">Scale + </div>
          <ul class="text-[12.5px] space-y-1.5 list-none p-0">
            <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="Sınırsız request / proje" data-en="Unlimited requests / projects">Sınırsız request / proje</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="Dedicated cluster" data-en="Dedicated cluster">Dedicated cluster</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="Region pin (KVKK için TR)" data-en="Region pin (TR for KVKK)">Region pin (KVKK için TR)</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>99.99% SLA</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>4 sa <span data-tr="ilk yanıt, 24/7" data-en="first response, 24/7">ilk yanıt, 24/7</span></li>
            <li class="flex gap-2"><span class="text-primary">✓</span>SAML SSO + SCIM</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>SOC 2 · GDPR · KVKK</li>
            <li class="flex gap-2"><span class="text-primary">✓</span>MSA · DPA · özel sözleşme</li>
            <li class="flex gap-2"><span class="text-primary">✓</span><span data-tr="Yıllık fatura, TL opsiyonu" data-en="Annual invoice, TRY option">Yıllık fatura, TL opsiyonu</span></li>
          </ul>
        </div>
      </div>
    </div>

    <p class="mt-6 text-[12.5px] text-muted-foreground text-center" data-tr="Tüm fiyatlar KDV hariç. Türkiye'deki müşteriler için TL fatura kesilebilir. Yıllık ödemede %20 indirim." data-en="All prices exclude VAT. TRY invoicing available for Turkey-based customers. 20% off annual plans.">Tüm fiyatlar KDV hariç. Türkiye'deki müşteriler için TL fatura kesilebilir. Yıllık ödemede %20 indirim.</p>
  </div>
</section>

<!-- ─────────────────── Full comparison table ─────────────────── -->
<section class="py-20 border-b border-border bg-muted/40">
  <div class="max-w-[1240px] mx-auto px-8 max-md:px-5">
    <div class="flex flex-col gap-4 max-w-[720px] mb-10">
      <span class="inline-flex items-center gap-2 font-mono text-[11px] text-muted-foreground uppercase tracking-[0.12em] whitespace-nowrap self-start"><span class="w-1.5 h-1.5 bg-primary rounded-full"></span><span data-tr="tam karşılaştırma" data-en="full comparison">tam karşılaştırma</span></span>
      <h2 class="text-[clamp(24px,3vw,32px)] font-semibold -tracking-[0.022em] leading-[1.15]" data-tr="Her şey, satır satır." data-en="Everything, line by line.">Her şey, satır satır.</h2>
    </div>
    <div class="border border-border rounded-3xl bg-card overflow-x-auto">
      <table class="w-full border-collapse text-[13px] min-w-[820px]">
        <thead>
          <tr class="bg-muted">
            <th class="px-5 py-3.5 text-left font-medium text-xs uppercase tracking-wider text-muted-foreground border-b border-border sticky left-0 bg-muted" data-tr="Özellik" data-en="Feature">Özellik</th>
            <th class="px-5 py-3.5 text-left font-medium text-xs uppercase tracking-wider text-muted-foreground border-b border-border">Free</th>
            <th class="px-5 py-3.5 text-left font-medium text-xs uppercase tracking-wider text-foreground border-b border-border">Pro</th>
            <th class="px-5 py-3.5 text-left font-medium text-xs uppercase tracking-wider text-muted-foreground border-b border-border">Scale</th>
            <th class="px-5 py-3.5 text-left font-medium text-xs uppercase tracking-wider text-muted-foreground border-b border-border">Enterprise</th>
          </tr>
        </thead>
        <tbody>
          <!-- Capacity -->
          <tr class="bg-muted/50">
            <td colspan="5" class="px-5 py-2 text-[11px] uppercase tracking-wider font-mono text-muted-foreground" data-tr="kapasite" data-en="capacity">kapasite</td>
          </tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium" data-tr="Aylık request" data-en="Monthly requests">Aylık request</td><td class="px-5 py-2.5 border-b border-border font-mono">100K</td><td class="px-5 py-2.5 border-b border-border font-mono">10M</td><td class="px-5 py-2.5 border-b border-border font-mono">100M</td><td class="px-5 py-2.5 border-b border-border font-mono" data-tr="sınırsız" data-en="unlimited">sınırsız</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">CPU / request</td><td class="px-5 py-2.5 border-b border-border font-mono">10ms</td><td class="px-5 py-2.5 border-b border-border font-mono">30s</td><td class="px-5 py-2.5 border-b border-border font-mono">5min</td><td class="px-5 py-2.5 border-b border-border font-mono" data-tr="özel" data-en="custom">özel</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium" data-tr="D1 boyutu" data-en="D1 size">D1 boyutu</td><td class="px-5 py-2.5 border-b border-border font-mono">500MB</td><td class="px-5 py-2.5 border-b border-border font-mono">5GB</td><td class="px-5 py-2.5 border-b border-border font-mono">50GB</td><td class="px-5 py-2.5 border-b border-border font-mono" data-tr="özel" data-en="custom">özel</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium" data-tr="R2 storage" data-en="R2 storage">R2 storage</td><td class="px-5 py-2.5 border-b border-border font-mono">1GB</td><td class="px-5 py-2.5 border-b border-border font-mono">25GB</td><td class="px-5 py-2.5 border-b border-border font-mono">500GB</td><td class="px-5 py-2.5 border-b border-border font-mono" data-tr="özel" data-en="custom">özel</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium" data-tr="Egress" data-en="Egress">Egress</td><td class="px-5 py-2.5 border-b border-border text-primary font-mono">∞</td><td class="px-5 py-2.5 border-b border-border text-primary font-mono">∞</td><td class="px-5 py-2.5 border-b border-border text-primary font-mono">∞</td><td class="px-5 py-2.5 border-b border-border text-primary font-mono">∞</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium" data-tr="Realtime bağlantı" data-en="Realtime conn.">Realtime bağlantı</td><td class="px-5 py-2.5 border-b border-border font-mono">50</td><td class="px-5 py-2.5 border-b border-border font-mono">5K</td><td class="px-5 py-2.5 border-b border-border font-mono">50K</td><td class="px-5 py-2.5 border-b border-border font-mono" data-tr="özel" data-en="custom">özel</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium" data-tr="Proje sayısı" data-en="Projects">Proje sayısı</td><td class="px-5 py-2.5 border-b border-border font-mono">1</td><td class="px-5 py-2.5 border-b border-border font-mono">3</td><td class="px-5 py-2.5 border-b border-border font-mono">25</td><td class="px-5 py-2.5 border-b border-border font-mono" data-tr="sınırsız" data-en="unlimited">sınırsız</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium" data-tr="Takım üyesi" data-en="Team members">Takım üyesi</td><td class="px-5 py-2.5 border-b border-border font-mono">1</td><td class="px-5 py-2.5 border-b border-border font-mono">10</td><td class="px-5 py-2.5 border-b border-border font-mono">50</td><td class="px-5 py-2.5 border-b border-border font-mono" data-tr="sınırsız" data-en="unlimited">sınırsız</td></tr>

          <!-- Regions / runtime -->
          <tr class="bg-muted/50"><td colspan="5" class="px-5 py-2 text-[11px] uppercase tracking-wider font-mono text-muted-foreground" data-tr="çalışma · region" data-en="runtime · region">çalışma · region</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium" data-tr="Edge region sayısı" data-en="Edge regions">Edge region sayısı</td><td class="px-5 py-2.5 border-b border-border font-mono">1</td><td class="px-5 py-2.5 border-b border-border font-mono">3</td><td class="px-5 py-2.5 border-b border-border font-mono">11</td><td class="px-5 py-2.5 border-b border-border font-mono" data-tr="özel" data-en="custom">özel</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium" data-tr="Region pinning" data-en="Region pinning">Region pinning</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium" data-tr="Custom domain" data-en="Custom domain">Custom domain</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td></tr>
          <tr><td class="px-5 py-2.5 border-b border-border font-medium">Preview branches</td><td class="px-5 py-2.5 border-b border-border text-muted-foreground">—</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td><td class="px-5 py-2.5 border-b border-border text-primary">✓</td></tr>

          <!-- Backup -->
          <tr class="bg-muted/50"><td colspan="5" class="px-5 py-2 text-[11px] uppercase tracking-wider font-mono text-muted-foreground" data-tr="yedek · geri yükleme" data-en="backup · restore">yedek · geri yükleme</td></tr>
