<script is:inline>
  // Billing toggle (monthly <-> annual): swap displayed prices + the per-card
  // billing caption, and carry the chosen interval into the plan sign-up CTAs.
  (function () {
    var btns = Array.prototype.slice.call(document.querySelectorAll("[data-billing]"));
    if (!btns.length) return;
    function apply(mode) {
      document.querySelectorAll("[data-price-monthly]").forEach(function (el) {
        var val = mode === "annual" ? el.dataset.priceAnnual : el.dataset.priceMonthly;
        el.textContent = "$" + val;
      });
      document.querySelectorAll("[data-bill-monthly]").forEach(function (el) {
        el.textContent = mode === "annual" ? el.dataset.billAnnual : el.dataset.billMonthly;
      });
      document.querySelectorAll('a[href*="/sign-up?plan="]').forEach(function (a) {
        try {
          var u = new URL(a.href);
          if (mode === "annual") u.searchParams.set("interval", "annual");
          else u.searchParams.delete("interval");
          a.href = u.toString();
        } catch (e) {}
      });
      btns.forEach(function (b) {
        b.setAttribute("aria-pressed", String(b.dataset.billing === mode));
      });
    }
    btns.forEach(function (b) {
      b.addEventListener("click", function () {
        apply(b.dataset.billing);
      });
    });
    apply("monthly");
  })();
</script>
