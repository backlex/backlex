    if (!monthlyBtn || !annualBtn) return;
    function apply(mode) {
      document.querySelectorAll("[data-price-monthly]").forEach(function (el) {
        var val = mode === "monthly" ? el.dataset.priceMonthly : el.dataset.priceAnnual;
        el.textContent = "€" + val;
      });
      [monthlyBtn, annualBtn].forEach(function (b) {
        var on = b.id === "billing-" + mode;
        b.classList.toggle("bg-muted", on);
        b.classList.toggle("text-foreground", on);
        b.classList.toggle("text-muted-foreground", !on);
      });
    }
    monthlyBtn.addEventListener("click", function () { apply("monthly"); });
    annualBtn.addEventListener("click", function () { apply("annual"); });
    apply("monthly");
  })();
</script>
</Base>
