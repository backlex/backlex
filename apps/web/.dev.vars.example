APP_URL = "http://localhost:5173"
AUTH_SECRET = "dev-only-secret-not-for-prod-please-rotate"

# Optional — sign app-plane access tokens with a key pair instead of HS256, and
# publish the public half at /.well-known/jwks.json so other services can verify
# a backlex token locally (no shared secret). PKCS#8 PEM, EC P-256 or RSA:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# AUTH_JWT_PRIVATE_KEY = """-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----"""
# During rotation, keep the OLD public key (SPKI PEM) here until its tokens expire:
# AUTH_JWT_PUBLIC_KEYS = """-----BEGIN PUBLIC KEY-----\n…\n-----END PUBLIC KEY-----"""

# Database — pick ONE block. Without DATABASE_URL the runtime falls back to
# bun:sqlite at ./.data/backlex.sqlite (or to the D1 binding on CF Workers).
# Full provider matrix + caveats: docs/database-providers.md
#
# Self-hosted Postgres
# DATABASE_URL = "postgres://user:pass@localhost:5432/backlex"
#
# Supabase — use the **transaction pooler** URL (port 6543). postgres-js
# already runs with `prepare: false` so the pooler is happy. pgvector is
# enabled per project (Dashboard → Database → Extensions → vector).
# DATABASE_URL = "postgres://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres"
#
# Neon — works with the default postgres-js driver on Bun/CF Workers/Node.
# On Vercel Edge set DATABASE_DRIVER=neon-http (no node:net there). pgvector
# is available; enable it once with `CREATE EXTENSION vector;`.
# DATABASE_URL = "postgres://<user>:<pwd>@ep-<id>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
# DATABASE_DRIVER = "neon-http"   # Vercel Edge only
#
# Xata — standard PG wire (postgres-js works). NOTE: Xata does NOT ship the
# pgvector extension. To use backlex' vector endpoints with Xata you must
# also bind a Cloudflare Vectorize index (VECTORIZE_OPENAI / VECTORIZE_BGE_M3)
# or vector endpoints will reject with "No vector backend configured".
# DATABASE_URL = "postgres://<workspace-id>:<api-key>@<workspace>.<region>.xata.sh:5432/<db>:<branch>?sslmode=require"

# Turso / libSQL — selects the libSQL HTTP/WS transport. Works on every
# runtime (Bun, Node, CF Workers, Vercel/Netlify Edge). Loses to D1 binding
# but wins over DATABASE_URL. Apply migrations once with
#   LIBSQL_URL=… LIBSQL_AUTH_TOKEN=… bun run --cwd packages/db migrate:libsql
# LIBSQL_URL = "libsql://my-db-org.turso.io"
# LIBSQL_AUTH_TOKEN = "eyJ..."

# LiteFS (Fly.io) — needs zero env wiring. Mount the LiteFS volume, point
# SQLITE_PATH at the mounted SQLite file, and the Bun SQLite driver picks
# it up unchanged. Writes routed to the primary node automatically by the
# FUSE layer; replicas serve reads.
# SQLITE_PATH = "/litefs/backlex.sqlite"

# Local-only seeded admin used by smoke tests / Claude debug runs.
# Sign in or POST /api/auth/sign-up/email with these on a fresh DB; if
# they are not the first user, manually insert into user_roles to grant
# the admin role (see CLAUDE.md "Local test admin").
TEST_ADMIN_EMAIL = "admin@example.com"
TEST_ADMIN_PASSWORD = "correct-horse-battery"

# Email transport. EMAIL_PROVIDER picks one explicitly (console | resend |
# sendgrid | mailgun | ses | smtp); when unset it's auto-detected from
# whichever provider's credentials are present (priority: resend → sendgrid →
# mailgun → ses → smtp), else logged to stdout via the console adapter. Every
# provider needs EMAIL_FROM too.
# EMAIL_PROVIDER = "resend"
# EMAIL_FROM = "onboarding@resend.dev"   # Resend's test sender (no domain
#                                          verification); use your own verified
#                                          domain/address in production.
# --- pick ONE provider's block ---
# RESEND_API_KEY = "re_..."
# SENDGRID_API_KEY = "SG...."
# MAILGUN_API_KEY = "key-..."
# MAILGUN_DOMAIN = "mg.example.com"      # MAILGUN_HOST = "api.eu.mailgun.net" for EU
# SES_REGION = "us-east-1"
# SES_ACCESS_KEY_ID = "AKIA..."
# SES_SECRET_ACCESS_KEY = "..."
# Cloudflare Turnstile — spam guard for public form submissions (Data → Forms).
# The site key is public (rendered into the form page); the secret verifies
# challenges server-side. A turnstile-enabled form fails closed without the secret.
# TURNSTILE_SITE_KEY = "0x..."
# TURNSTILE_SECRET_KEY = "0x..."
# Usage limits (docs/usage-metering.md) — platform-side plan pins. Each key
# set here OVERRIDES the admin-editable usageLimits setting field-by-field
# (this is how managed cloud injects a tenant's plan). All optional.
# USAGE_LIMIT_MODE = "hard"               # off | soft | hard
# USAGE_LIMIT_REQUESTS_MONTH = "100000"
# USAGE_LIMIT_STORAGE_BYTES = "1073741824"
# USAGE_LIMIT_DB_ROWS = "50000"
# SMTP — NOTE: works on Bun / Vercel / Netlify / self-host, NOT Cloudflare
# Workers (no raw TCP). SMTP_SECURE=true for implicit TLS on 465; leave unset
# for 587/25 (STARTTLS auto-negotiated).
# SMTP_HOST = "smtp.example.com"
# SMTP_PORT = "587"
# SMTP_USER = "apikey-or-username"
# SMTP_PASSWORD = "..."
# SMTP_SECURE = "false"

# AI providers — `AI_GATEWAY_API_KEY` is the preferred multi-provider
# credential and routes every `ai.*` MCP tool + Ask AI planner call through
# https://ai-gateway.vercel.sh (Anthropic, OpenAI, Google, …). Models are
# provider-prefixed: `anthropic/claude-haiku-4-5`, `openai/gpt-5`,
# `google/gemini-2.5-pro`. When unset but `ANTHROPIC_API_KEY` is set, the
# client falls back to the direct Anthropic provider for backward compat.
# AI_GATEWAY_API_KEY = "vck_..."
# ANTHROPIC_API_KEY = "sk-ant-..."
# Or skip the static key entirely: ANTHROPIC_AUTH_TOKEN takes a short-lived
# OAuth bearer token (`ant auth login`, then `ant auth print-credentials
# --access-token`). Lowest precedence of the three, and it EXPIRES — handy for
# local dev, not for a long-running deployment.
# ANTHROPIC_AUTH_TOKEN = "sk-ant-oat01-..."

# OAuth providers — both id+secret required to enable. Each is auto-wired
# into better-auth's socialProviders if both are present. The admin Auth
# Settings page can also store per-workspace overrides (encrypted).
# OAUTH_GOOGLE_CLIENT_ID = "..."
# OAUTH_GOOGLE_CLIENT_SECRET = "..."
# OAUTH_GITHUB_CLIENT_ID = "..."
# OAUTH_GITHUB_CLIENT_SECRET = "..."
# OAUTH_APPLE_CLIENT_ID = "..."          # Service ID (e.g. com.example.signin)
# OAUTH_APPLE_CLIENT_SECRET = "..."      # Generated JWT signed with the Apple key

# Extension installs resolve npm packages against this registry. Defaults to
# the public registry; point at a private mirror to gate what admins can pull.
# EXTENSIONS_NPM_REGISTRY = "https://registry.npmjs.org"
