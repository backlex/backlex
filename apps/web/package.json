{
  "name": "@backlex/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx vite",
    "dev:bun": "bun run --hot src/server/entries/bun.ts",
    "build": "bun scripts/gen-openapi-static.ts && bunx --bun vite build",
    "gen:openapi-static": "bun scripts/gen-openapi-static.ts",
    "i18n:extract": "lingui extract",
    "preview": "bunx vite preview",
    "deploy": "bun scripts/gen-openapi-static.ts && bunx --bun vite build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json --checkers 2",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json --checkers 2",
    "test": "bun test --timeout 30000 --parallel=4 --no-isolate --timings=../../.github/test-timings.json tests/"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.45",
