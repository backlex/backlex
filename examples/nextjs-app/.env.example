# Copy to `.env` and fill in.
#
# None of these are `NEXT_PUBLIC_`-prefixed: this app never builds a backlex
# client in the browser. Server Components read, Server Actions write, and the
# session token lives in an httpOnly cookie the browser can't read.

# Where the backlex API lives. Server-side fetches go straight here — there is
# no dev proxy, because no request originates from the browser.
BACKLEX_URL=http://localhost:5173

# Slug of the workspace (tenant) end-users sign into. Create one in the admin UI
# → Workspaces, and enable open signup so the app can self-register.
BACKLEX_WORKSPACE=

# Optional. Name of the cookie holding the workspace session token.
# BACKLEX_SESSION_COOKIE=backlex_session
