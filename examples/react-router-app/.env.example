# Copy to `.env` and fill in.
#
# NOTE: unlike the Vite examples, these are NOT `VITE_`-prefixed — that prefix
# is exactly what inlines a value into the browser bundle, which is the one
# thing an admin API key must never do. React Router reads them via
# `process.env` inside loaders/actions, so they stay on the server.

# Where the backlex API lives.
BACKLEX_URL=http://localhost:5173

# Admin API key (`pak_...`), minted in the admin UI → API keys. This grants the
# admin plane — jobs, flows, agents, permissions, usage. Server-only: it is read
# in loaders/actions and never serialized into a loader's return value.
BACKLEX_API_KEY=

# Optional. Scope requests to a specific workspace (slug or id) by sending the
# X-Backlex-Tenant header. Needed when the key addresses a tenant other than its
# home one; leave empty otherwise.
BACKLEX_TENANT=
