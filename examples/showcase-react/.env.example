# Copy to `.env` and fill in.

# The slug of the workspace (tenant) this app signs its end-users into.
# Create one in the admin UI (Workspaces) — see this folder's README. Left
# blank on purpose: the app's setup screen tells you what to fill in here.
VITE_BACKLEX_WORKSPACE=

# ── Local dev (default) ──────────────────────────────────────────────────────
# Leave VITE_BACKLEX_URL empty to talk to the API same-origin through the Vite
# dev proxy (see vite.config.ts) — no CORS setup needed. The proxy forwards
# /api/* to VITE_BACKLEX_PROXY_TARGET below.
VITE_BACKLEX_URL=
VITE_BACKLEX_PROXY_TARGET=http://localhost:5173

# ── Web Push (optional — Messaging panel) ────────────────────────────────────
# VAPID public key, copied from the admin → Settings → Push. It's public by
# design (browsers require it client-side and it ships in the bundle); the
# matching PRIVATE key stays on the backend. Leave empty to skip the browser
# push demo — device listing and SMS registration work either way.
VITE_BACKLEX_VAPID_PUBLIC_KEY=

# ── Production (cross-origin) ────────────────────────────────────────────────
# Instead, set VITE_BACKLEX_URL to your deployed backlex origin and register
# this app's origin as trusted on the backend (EXTRA_TRUSTED_ORIGINS, or the
# workspace's auth redirect URLs). Then VITE_BACKLEX_PROXY_TARGET is unused.
# VITE_BACKLEX_URL=https://api.your.app
