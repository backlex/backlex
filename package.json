{
  "name": "backlex",
  "version": "0.0.1",
  "private": true,
  "description": "Bun + Cloudflare Workers backend platform (Supabase/Directus alternative) with Drizzle, better-auth and shadcn admin",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:bun": "bun run --cwd apps/web dev:bun",
    "build": "bun scripts/require-green-checks.ts && bun run --cwd apps/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "db:generate:pg": "bun run --cwd packages/db generate:pg",
    "db:generate:sqlite": "bun run --cwd packages/db generate:sqlite",
    "db:migrate:pg": "bun run --cwd packages/db migrate:pg",
    "db:migrate:sqlite": "bun run --cwd packages/db migrate:sqlite",
    "db:migrate:d1": "bun run --cwd packages/db migrate:d1",
    "db:migrate:d1:remote": "bun run --cwd packages/db migrate:d1 -- --remote",
    "db:compact:d1-ledger": "bun run --cwd packages/db compact:d1-ledger --",
    "db:studio": "bun run --cwd packages/db studio",
    "deploy": "bun run --cwd apps/web deploy",
    "dev:site": "bun run --cwd apps/site dev",
    "build:site": "bun run --cwd apps/site build",
    "build:examples": "bun run --filter '@backlex-examples/*' build",
    "build:targets": "bun scripts/build-targets.ts",
    "build:node": "bun scripts/build-node.ts",
    "start:node": "node apps/web/dist/node/server.mjs",
    "build:lambda": "bun scripts/build-lambda.ts",
    "build:gcp": "bun scripts/build-gcp.ts",
    "build:azure": "bun scripts/build-azure.ts",
    "build:deno": "bun scripts/build-deno.ts",
    "test": "bun run --cwd apps/web test",
    "lint": "biome lint apps packages examples",
    "lint:fix": "biome lint --write apps packages examples",
    "prepare": "lefthook install --force || true",
    "backlex": "bun run packages/cli/bin/backlex.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "latest",
    "@vercel/config": "0.5.0",
    "lefthook": "^2.1.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "resolutions": {
    "zod": "^4.4.3"
  }
}
