{
  "name": "@backlex/auth-ui",
  "version": "0.1.0",
  "description": "backlex auth screens — i18n-free, router-agnostic React components for sign-in / sign-up / forgot / reset / magic-link. Source-consumed; consumers pass copy + auth client + navigate.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backlex/backlex.git",
    "directory": "packages/auth-ui"
  },
  "homepage": "https://github.com/backlex/backlex/tree/main/packages/auth-ui",
  "bugs": "https://github.com/backlex/backlex/issues",
  "keywords": [
    "backlex",
    "auth",
    "sign-in",
    "sign-up",
    "magic-link",
    "react",
    "better-auth"
  ],
  "type": "module",
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.14.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@backlex/ui": "workspace:*",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@backlex/ui": ">=0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./auth-shell.css": "./src/auth-shell.css",
    "./components/*": "./src/components/*.tsx",
    "./pages/*": "./src/pages/*.tsx"
  }
}
