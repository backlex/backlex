{
  "name": "@backlex/cli",
  "version": "0.5.0",
  "description": "The backlex CLI \u2014 auth/profiles, collection + item CRUD, backups, users/roles, feature flags, functions/flows/webhooks/jobs, advisor, scaffolding, and type/OpenAPI generation against any backlex instance.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://backlex.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backlex/backlex.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/backlex/backlex/issues",
  "keywords": [
    "backlex",
    "backend-as-a-service",
    "baas",
    "cli",
    "command-line",
    "devtools"
  ],
  "bin": {
    "backlex": "./bin/backlex.ts"
  },
  "files": [
    "dist",
    "drizzle",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "surface:record": "bun run scripts/record-surface.ts"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-beta.22",
    "mongodb": "^6.10.0",
    "mysql2": "^3.23.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1111.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@backlex/migrate": "workspace:*",
    "@google-cloud/firestore": "^7.11.0",
    "@types/bun": "latest",
    "backlex": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "7.0.2"
  }
}
