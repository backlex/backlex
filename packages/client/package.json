{
  "name": "@backlex/client",
  "version": "0.0.1",
  "description": "Typed TypeScript client for the backlex API — auth, collection CRUD, query builder, realtime, storage, jobs, flags, and offline sync. Ships as source; runs on any bundler (Vite, Next, esbuild, Bun, Deno) and on Node ≥22.6 native type-stripping.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://backlex.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backlex/backlex.git",
    "directory": "packages/client"
  },
  "bugs": "https://github.com/backlex/backlex/issues",
  "keywords": [
    "backlex",
    "backend-as-a-service",
    "baas",
    "sdk",
    "client",
    "typescript",
    "rest",
    "realtime"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./webhook": "./src/webhook.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
