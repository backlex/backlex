{
  "name": "backlex",
  "version": "0.2.0",
  "description": "Typed TypeScript client for the backlex API — auth, collection CRUD, query builder, realtime, storage, jobs, flows, flags, and offline sync. Zero required dependencies (`ably` is an optional peer, needed only by serverless deployments that use the signal realtime plane). On npm as compiled ESM + types; on JSR (@backlex/backlex) as TypeScript source.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://backlex.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backlex/backlex.git",
    "directory": "packages/client"
  },
  "bugs": "https://github.com/backlex/backlex/issues",
  "keywords": [
    "backlex",
    "backend-as-a-service",
    "baas",
    "sdk",
    "client",
    "typescript",
    "rest",
    "realtime"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./webhook": "./src/webhook.ts",
    "./token": "./src/token.ts",
    "./react": "./src/react.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "ably": ">=2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "ably": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "ably": "^2.24.0",
    "react": "^19.2.7",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
