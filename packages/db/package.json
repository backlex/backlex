{
  "name": "@backlex/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./email": "./src/email.ts",
    "./geo": "./src/geo.ts",
    "./money": "./src/money.ts",
    "./order": "./src/order.ts",
    "./phone": "./src/phone.ts",
    "./range": "./src/range.ts",
    "./retirement": "./src/retirement.ts",
    "./sequence": "./src/sequence.ts",
    "./slug": "./src/slug.ts",
    "./transitions": "./src/transitions.ts",
    "./url": "./src/url.ts",
    "./pg": "./src/pg/index.ts",
    "./pg/schema": "./src/pg/schema.ts",
    "./pg/migrations-bundle": "./src/pg/migrations-bundle.ts",
    "./sqlite": "./src/sqlite/index.ts",
    "./sqlite/schema": "./src/sqlite/schema.ts",
    "./sqlite/migrations-bundle": "./src/sqlite/migrations-bundle.ts",
    "./sqlite/bun": "./src/sqlite/bun.ts",
    "./sqlite/libsql": "./src/sqlite/libsql.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate:pg": "drizzle-kit generate --config=drizzle.pg.config.ts && bun run scripts/build-manifest.ts",
    "generate:sqlite": "drizzle-kit generate --config=drizzle.sqlite.config.ts && bun run scripts/build-manifest.ts",
    "manifest": "bun run scripts/build-manifest.ts",
    "migrate:pg": "bun run src/pg/migrate.ts",
    "migrate:sqlite": "bun run src/sqlite/migrate.ts",
    "migrate:libsql": "bun run src/sqlite/migrate-libsql.ts",
    "migrate:d1": "bun run src/sqlite/migrate-d1.ts",
    "compact:d1-ledger": "bun run src/sqlite/compact-d1-ledger.ts",
    "studio:pg": "drizzle-kit studio --config=drizzle.pg.config.ts"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@neondatabase/serverless": "1.1.0",
    "@backlex/core": "workspace:*",
    "drizzle-orm": "1.0.0-beta.22",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "1.0.0-beta.22",
    "typescript": "6.0.3"
  }
}
