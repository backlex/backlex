{
  "name": "@backlex/integrations",
  "version": "0.1.0",
  "description": "Runtime-agnostic third-party integration adapters (Slack, Discord, Teams, Telegram, Datadog, Sentry, PagerDuty, Opsgenie, GitHub, and more) plus payment-provider adapters (Stripe, Polar, Lemon Squeezy) for backlex.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./provider": "./src/provider.ts",
    "./payments": "./src/payments.ts",
    "./checkout": "./src/checkout.ts",
    "./refunds": "./src/refunds.ts"
  },
  "files": ["src"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backlex/backlex.git",
    "directory": "packages/integrations"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
