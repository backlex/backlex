<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>Backlex</PackageId>
    <Version>0.0.1</Version>
    <Description>Official .NET client for the backlex API (CRUD, query builder, auth, realtime, storage).</Description>
    <!-- Zero NuGet dependencies: only System.Net.Http + System.Text.Json (BCL). -->
  </PropertyGroup>

</Project>
